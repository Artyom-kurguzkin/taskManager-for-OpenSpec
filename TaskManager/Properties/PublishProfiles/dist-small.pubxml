<Project>
  <!-- dotnet publish TaskManager -p:PublishProfile=dist-small  →  dist/TaskManager-small.exe (shares dist/wwwroot)
       Framework-dependent: much smaller, but the PC needs the .NET 10 Desktop Runtime
       (winget install Microsoft.DotNet.DesktopRuntime.10). -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- startup (research fast-startup-2026-11-20, Part A): ReadyToRun precompiles our assemblies instead of JIT-compiling them on every start (R4, R21); no compression, it costs unpack time at each start (R1-R3) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Photino.Native and WebView2Loader stay beside the exe, as wwwroot does: no extract-to-%TEMP%\.net step before the app starts (R1) -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- staged in obj, then only the exe (renamed) and wwwroot go to dist, so it can sit next to the self-contained build -->
    <PublishDir>$(MSBuildThisFileDirectory)../../obj/dist-small/</PublishDir>
    <DistDir>$(MSBuildThisFileDirectory)../../../dist/</DistDir>
    <!-- the profile's own staging folder, normalised; `dotnet publish -o <folder>` overrides PublishDir globally, so the two then differ -->
    <SmallStageDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../../obj/dist-small/'))</SmallStageDir>
  </PropertyGroup>
  <!-- dist is touched only by a publish into the profile's own folder (and not with -p:UpdateDist=false): a publish to a scratch folder (-o <folder>, e.g. a measurement) must neither stop the running app nor replace dist -->
  <PropertyGroup>
    <PublishDirNormalized>$([MSBuild]::NormalizeDirectory('$(PublishDir)'))</PublishDirNormalized>
    <UpdateDist Condition="'$(UpdateDist)' == '' And '$(PublishDirNormalized)' == '$(SmallStageDir)'">true</UpdateDist>
  </PropertyGroup>
  <Target Name="StopWhatRunsFromDist" BeforeTargets="CopySmallToDist" Condition="'$(UpdateDist)' == 'true'">
    <!-- everything running from dist is stopped first (the app, its board server, every Claude Code session's board connector): a running exe cannot be overwritten; sessions pick the new build up when they reconnect -->
    <!-- each process gets a stopped-by-publish-<pid> file in the app's logs folder first (RTM_HOME's, or %LOCALAPPDATA%\RepoTaskManager): the next start of the app reads it and says the run was stopped by a publish, not that it crashed -->
    <Exec ContinueOnError="true" Command="powershell -NoProfile -Command &quot;$d=[IO.Path]::GetFullPath('$(DistDir)'); $h=$env:RTM_HOME; if (-not $h) { $h=Join-Path $env:LOCALAPPDATA 'RepoTaskManager' }; $l=Join-Path $h 'logs'; New-Item -ItemType Directory -Force $l | Out-Null; Get-Process | Where-Object { $_.Path -and $_.Path.StartsWith($d,[StringComparison]::OrdinalIgnoreCase) } | ForEach-Object { Set-Content -LiteralPath (Join-Path $l ('stopped-by-publish-' + $_.Id)) (Get-Date -Format o); Stop-Process -Id $_.Id -Force }; Start-Sleep -Milliseconds 700&quot;" />
  </Target>
  <Target Name="CopySmallToDist" AfterTargets="Publish" Condition="'$(UpdateDist)' == 'true'">
    <ItemGroup><SmallWwwroot Include="$(PublishDir)wwwroot/**" /></ItemGroup>
    <!-- loose build files left in dist by older framework-dependent publishes: nothing reads them (the exe is single-file), and they made every build look as old as they were (#wi178 decision 6); only these patterns, only here -->
    <ItemGroup><StaleLoose Include="$(DistDir)TaskManager*.dll;$(DistDir)*.deps.json;$(DistDir)*.runtimeconfig.json" /></ItemGroup>
    <Delete Files="@(StaleLoose)" ContinueOnError="true" />
    <Copy SourceFiles="$(PublishDir)TaskManager.exe" DestinationFiles="$(DistDir)TaskManager-small.exe" />
    <!-- the native libraries are no longer bundled in the exe: they go beside it; taken from the resolved package files, not from the staging folder (an incremental publish into a stale staging folder once left them out there) -->
    <ItemGroup><SmallNative Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'Photino.Native'" /></ItemGroup>
    <Copy SourceFiles="@(SmallNative)" DestinationFolder="$(DistDir)" />
    <Copy SourceFiles="@(SmallWwwroot)" DestinationFolder="$(DistDir)wwwroot/%(RecursiveDir)" />
  </Target>
</Project>
