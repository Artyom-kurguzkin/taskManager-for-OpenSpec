<Project>
  <!-- dotnet publish TaskManager -p:PublishProfile=dist-small  →  dist/TaskManager-small.exe (shares dist/wwwroot)
       Framework-dependent: much smaller, but the PC needs the .NET 10 Desktop Runtime
       (winget install Microsoft.DotNet.DesktopRuntime.10). -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- staged in obj, then only the exe (renamed) and wwwroot go to dist, so it can sit next to the self-contained build -->
    <PublishDir>$(MSBuildThisFileDirectory)../../obj/dist-small/</PublishDir>
    <DistDir>$(MSBuildThisFileDirectory)../../../dist/</DistDir>
  </PropertyGroup>
  <Target Name="CopySmallToDist" AfterTargets="Publish">
    <ItemGroup><SmallWwwroot Include="$(PublishDir)wwwroot/**" /></ItemGroup>
    <Copy SourceFiles="$(PublishDir)TaskManager.exe" DestinationFiles="$(DistDir)TaskManager-small.exe" />
    <Copy SourceFiles="@(SmallWwwroot)" DestinationFolder="$(DistDir)wwwroot/%(RecursiveDir)" />
  </Target>
</Project>
