<Project>
  <!-- dotnet publish TaskManager -p:PublishProfile=dist  →  dist/TaskManager.exe (self-contained, no .NET install needed) -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- startup (research fast-startup-2026-11-20, Part A): ReadyToRun precompiles our assemblies and the bundled framework (R4); no EnableCompressionInSingleFile, the composite R2R image would be unpacked at every start, 35-300 ms (R2, R3) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- native libraries beside the exe, not extracted to %TEMP%\.net at start (R1) -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)../../../dist/</PublishDir>
  </PropertyGroup>
  <!-- stops what runs from dist only when publishing into dist itself, not for `dotnet publish -o <scratch folder>` (which overrides PublishDir) -->
  <PropertyGroup>
    <PublishDirNormalized>$([MSBuild]::NormalizeDirectory('$(PublishDir)'))</PublishDirNormalized>
    <DistDirNormalized>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../../../dist/'))</DistDirNormalized>
  </PropertyGroup>
  <Target Name="StopWhatRunsFromDist" BeforeTargets="PrepareForPublish" Condition="'$(PublishDirNormalized)' == '$(DistDirNormalized)'">
    <!-- everything running from dist is stopped first (the app, its board server, every Claude Code session's board connector): a running exe cannot be overwritten; sessions pick the new build up when they reconnect -->
    <Exec ContinueOnError="true" Command="powershell -NoProfile -Command &quot;$d=[IO.Path]::GetFullPath('$(PublishDir)'); Get-Process | Where-Object { $_.Path -and $_.Path.StartsWith($d,[StringComparison]::OrdinalIgnoreCase) } | Stop-Process -Force; Start-Sleep -Milliseconds 700&quot;" />
  </Target>
</Project>
