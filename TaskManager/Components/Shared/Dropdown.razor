@* Styled select over RadzenDropDown, which brings keyboard navigation and the listbox roles; app.css dresses its trigger and
   panel the same way as the list's filter dropdowns. Options are (value, label) pairs; an optional swatch colours each. *@
<RadzenDropDown TValue="string" Data="Opts" TextProperty="Label" ValueProperty="Value" Value="@Value" ValueChanged="v => ValueChanged.InvokeAsync(v)"
                Placeholder="@Placeholder" Name="@Label" aria-label="@Label" class="@($"dd {Class}")" Style="@Style" Disabled="Disabled">
    <Template Context="o">@Row((Opt)o)</Template>
    <ValueTemplate Context="o">@Row((Opt)o)</ValueTemplate>
</RadzenDropDown>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<(string Value, string Label)> Options { get; set; } = [];
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string? Style { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Optional colour token per value (e.g. status band) shown as a swatch.</summary>
    [Parameter] public Func<string, string>? Swatch { get; set; }

    private sealed record Opt(string Value, string Label);

    // A non-empty value that no option names (stale or legacy data) is still shown, as itself, rather than as nothing.
    private IEnumerable<Opt> Opts => Options.Any(o => o.Value == Value) || string.IsNullOrEmpty(Value)
        ? Options.Select(o => new Opt(o.Value, o.Label))
        : Options.Select(o => new Opt(o.Value, o.Label)).Append(new Opt(Value, Value));

    private RenderFragment Row(Opt o) => __builder =>
    {
        @if (Swatch is not null) { <i class="sw-dot" style="background:var(@Swatch(o.Value))"></i> }
        <span>@o.Label</span>
    };
}
