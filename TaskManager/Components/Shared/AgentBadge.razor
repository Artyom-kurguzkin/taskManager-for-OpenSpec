@* "Claude, 3 min ago": who last wrote the item and how long ago, from its agentBy/agentAt stamp. Display only: it shows while the work
   is unreviewed and under a day old, so a glance says an agent is (or just was) working on it. *@
@inject IServiceProvider Services

@if (Text is string text)
{
    <span class="agent-badge" title="@AgentChip.TipFor(Item.AgentBy, Item.AgentAt)">@text</span>
}

@code {
    [Parameter, EditorRequired] public WorkItems.PublicDTOs.WorkItem Item { get; set; } = default!;

    /// <summary>The clock: the system's unless a <see cref="TimeProvider"/> is registered (a test moves time by hand).</summary>
    private TimeProvider Time => Services.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System;

    private string? Text => Describe(Item, Time.GetLocalNow().DateTime);

    /// <summary>"By, N min ago" under an hour, "By, N h ago" under a day; null when nobody stamped it, the user has reviewed it, or it is older.</summary>
    public static string? Describe(WorkItems.PublicDTOs.WorkItem item, DateTime now)
    {
        if (!item.AgentUnreviewed || item.AgentAt is not DateTime at) return null;
        TimeSpan age = now - at;
        if (age < TimeSpan.Zero) age = TimeSpan.Zero;   // a clock a little behind the writer's
        if (age >= TimeSpan.FromHours(24)) return null;
        return age < TimeSpan.FromHours(1) ? $"{item.AgentBy}, {(int)age.TotalMinutes} min ago" : $"{item.AgentBy}, {(int)age.TotalHours} h ago";
    }
}
