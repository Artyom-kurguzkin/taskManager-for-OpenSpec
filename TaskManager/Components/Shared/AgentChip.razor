@* Marks work an agent added or changed that the user has not reviewed; a click marks it reviewed. *@
<button type="button" class="cell filled agent-chip" style="--fill:var(--lilac)" title="@Tip" aria-label="Agent work: mark as reviewed"
        @onclick="OnReview" @onclick:stopPropagation="true">agent</button>

@code {
    [Parameter] public string? By { get; set; }
    [Parameter] public DateTime? At { get; set; }
    [Parameter] public EventCallback OnReview { get; set; }

    private string Tip => TipFor(By, At);

    /// <summary>The tooltip of anything that marks agent work as reviewed on a click.</summary>
    public static string TipFor(string? by, DateTime? at) =>
        $"Added or changed by {by ?? "an agent"}{(at is DateTime t ? $" · {t:d MMM HH:mm}" : "")} — click to mark as reviewed";
}