@* A work item field as a pill filled with its colour: status, label or priority. The one look for it on the list and the item page. *@
@if (ReadOnly)
{
    <span class="box cell filled" data-sk style="@Fill">@Text</span>
}
else
{
    <Dropdown Label="@Kind" Class="cell filled" Style="@Fill" Swatch="Colour" Options="Options" Value="@Value" ValueChanged="ValueChanged" />
}

@code {
    /// <summary>status, label or priority.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "status";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>Shown but not editable (an archived item's status).</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>The statuses to offer (a status pill): the project of the item shown. Without it the open project's own list.</summary>
    [Parameter] public IReadOnlyList<string>? Statuses { get; set; }

    // static: the list draws its cells as plain buttons with one shared picker (BoardPage) and takes the same colours and options
    public static Func<string, string> ColourOf(string kind) => kind switch { "label" => Ui.LabelColor, "priority" => Ui.PriorityColor, _ => Ui.Band };
    public static IReadOnlyList<(string Value, string Label)> OptionsOf(string kind, IReadOnlyList<string>? statuses = null) =>
        kind switch { "label" => Ui.LabelOptions, "priority" => Ui.PriorityOptions, _ => (statuses ?? WorkItems.WorkItemsApi.GetStatuses()).Select(s => (s, s)).ToList() };
    public static string FillOf(string kind, string value) => $"--fill:var({ColourOf(kind)(value)})";
    public static string TextOf(string kind, string value, IReadOnlyList<string>? statuses = null) => OptionsOf(kind, statuses).FirstOrDefault(o => o.Value == value).Label ?? value;

    private Func<string, string> Colour => ColourOf(Kind);
    private IReadOnlyList<(string Value, string Label)> Options => OptionsOf(Kind, Statuses);
    private string Fill => FillOf(Kind, Value);
    private string Text => TextOf(Kind, Value, Statuses);
}
