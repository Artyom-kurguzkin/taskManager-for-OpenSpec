@* A work item on the board: coloured title band (by status), features, a plain "date · people · done/total" meta row, tags. *@
@using TaskManager.Board
@using WorkItems.PublicDTOs
@inject TaskManager.Services.Workspace Workspace

@* data-id: the drag script (wwwroot/js/app.js) animates cards from their old to their new place by it *@
<article class="card @(Options.Compact ? "collapsed" : "") @(Selected ? "selected" : "") @(Item.Hidden ? "hidden-item" : "")" data-sk data-id="@Item.Id"
         @ondragstart="() => OnDragStart.InvokeAsync(Item)" @onclick="OnClick"
         @ondrop="() => OnDrop.InvokeAsync(Item)" @ondrop:stopPropagation="true">
    <span class="band" style="--band:var(@Ui.Band(Item.Status))">@Item.Title</span>
    @if (!Options.Compact)
    {
        @* features as chips (the column already is the feature when grouped by feature, so the status goes there) *@
        <span class="card-features">
            @if (Options.GroupBy == "feature") { <span class="muted">@Item.Status</span> }
            else if (Item.Features.Count == 0) { <span class="muted">no feature</span> }
            else { @foreach (string name in FeatureNames) { <span class="feat">@name</span> } }
        </span>
        <span class="meta-row">
            @Item.Modified.ToString("d MMM")
            @* the column already names the contributor when grouped by contributor, and the label when grouped by label *@
            @if (Options.GroupBy != "contributor" && Item.Contributors.Count > 0) { <text> · </text><span class="who-list">@string.Join(", ", Item.Contributors)</span> }
            @if (Item.Subtasks.Count > 0) { <text> · </text><span class="subs">@Item.Subtasks.Count(s => s.Done)/@Item.Subtasks.Count</span> }
        </span>
        <span class="tags">
            <span class="tag">#wi@(Item.Id)</span>
            @if (Item.Label is not null && Options.GroupBy != "label") { <span class="tag lbl" style="--fill:var(@Ui.LabelColor(Item.Label))">@Item.Label</span> }
            @if (Item.Due is DateOnly due) { <span class="tag due @(due < DateOnly.FromDateTime(DateTime.Today) && !Item.Archived ? "overdue hot" : "")" title="Due @due.ToString("d MMMM yyyy")">due @due.ToString("d MMM")</span> }
            @if (TestsFailing) { <span class="tag hot tests-failing" title="A linked test failed in the latest run">tests failing</span> }
            @if (Item.Warning is not null) { <span class="tag hot" title="@Item.Warning">!</span> }
            @if (BoardModel.AgentFlag(Item)) { <AgentChip By="@(Item.AgentBy ?? Item.Subtasks.FirstOrDefault(s => s.Agent is not null)?.Agent)" At="Item.AgentAt" OnReview="() => OnReview.InvokeAsync(Item)" /> }
        </span>
    }
</article>

@code {
    // Any linked test failed in the newest results file (LinkedTestRuns caches the file, so every card can ask).
    private bool TestsFailing => Item.Tests is { Count: > 0 } links && LinkedTestRuns.LinkedTestRunsApi.Latest().Results.Any(r => r.Outcome == "failed" && links.Any(t => t.Suite == r.Suite && t.Test == r.Test));

    [Parameter, EditorRequired] public WorkItem Item { get; set; } = default!;
    [Parameter, EditorRequired] public BoardOptions Options { get; set; } = default!;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public EventCallback<WorkItem> OnDragStart { get; set; }
    [Parameter] public EventCallback<WorkItem> OnDrop { get; set; }   // another card dropped onto this one
    [Parameter] public EventCallback<WorkItem> OnReview { get; set; } // the agent chip was clicked
    /// <summary>Feature path → name of the card's own project; the active project's names when not given.</summary>
    [Parameter] public IReadOnlyDictionary<string, string>? Names { get; set; }

    private IEnumerable<string> FeatureNames => Item.Features.Select(f => (Names ?? Workspace.FeatureNames).GetValueOrDefault(f.Path, f.Path));
}
