@namespace TaskManager.Components.Pages
@* Settings: where one project's board is shared between computers. Rendered from the provider descriptors, so a new provider needs no markup here. *@
@implements IDisposable
@if (Storage is not null && Sync is not null && view is not null && lastStatus is not null)
{
    // Drawn from what was worked out when something last changed (Load): drawing reads no file and writes none.
    BoardStorageConfig? config = view.Config;
    bool unreadable = view.Unreadable;
    StorageProvider? provider = config is null ? null : Storage.Find(config.Provider);
    SyncStatus status = lastStatus;
    StorageProposal? ask = status.Proposal;   // the repository names a storage this computer has not allowed: shown, never opened
    string project = System.IO.Path.GetFileName(Root.TrimEnd('\\', '/'));
    string id = new string([.. project.Select(c => char.IsLetterOrDigit(c) ? c : '-')]);
    <tbody data-storage>
        <tr>
            <th scope="row">Board storage</th>
            <td>
                <Seg Name="@("bs-mode-" + id)" Options="Modes" Value="@(config is null && !unreadable ? "this" : "connected")" ValueChanged="SetMode" />
                <p class="muted set-note">Keeps @project's board in step between your computers without a commit and a pull; it stays in git either way. It syncs when the app starts and closes, and two minutes after your last change.</p>
                @if (provider is not null) { <p class="muted set-note">@provider.Hint</p> }
                @if (unreadable)
                {
                    <p class="bs-state bad">@status.Line</p>
                }
                else if (ask is not null)
                {
                    <p class="bs-state bs-ask">@(postponedFor == ask.Line ? "Not syncing yet. " : "")@ask.Line</p>
                    @if (ask.Detail is not null) { <p class="muted bs-ask-detail">@ask.Detail</p> }
                    <div class="bs-actions">
                        <button class="btn primary bs-approve" data-sk @onclick="Approve">Allow this storage</button>
                        @if (postponedFor != ask.Line) { <button class="btn bs-later" data-sk @onclick="() => postponedFor = ask.Line">Not now</button> }
                    </div>
                }
            </td>
        </tr>
        @if (config is not null && !unreadable && ask is null)
        {
            <tr>
                <th scope="row">Storage</th>
                <td><Seg Name="@("bs-provider-" + id)" Options="Choices" Value="@config.Provider" ValueChanged="SetProvider" /></td>
            </tr>
        }
        @if (provider is not null && ask is null)
        {
            @foreach (StorageField field in provider.Fields)
            {
                <tr>
                    <th scope="row">@field.Label</th>
                    <td>
                        <input @key="@(field.Key + generation)" class="box text-in" data-sk data-field="@field.Key" type="@(field.Secret ? "password" : "text")" autocomplete="off"
                               value="@view.Values.GetValueOrDefault(field.Key)" placeholder="@Placeholder(field)" aria-label="@field.Label"
                               @onchange="e => SetValue(field, (string?)e.Value)" />
                    </td>
                </tr>
            }
            bool attachments = view.SyncAttachments;
            <tr>
                <th scope="row">Attachments</th>
                <td><div class="bs-attach">
                    <button type="button" class="nav-pill bs-attachments @(attachments ? "is-sel" : "")" data-sk aria-pressed="@(attachments ? "true" : "false")" @onclick="() => Report(Storage!.SetSyncAttachments(Root, !attachments))">Sync attachments too</button>
                    <span class="muted">The pictures and files attached to notes go through the same storage, under attachments/.</span>
                </div></td>
            </tr>
            <tr>
                <th scope="row">Sync</th>
                <td>
                    <div class="bs-actions">
                        <button class="btn bs-test" data-sk disabled="@testing" @onclick="TestConnection">@(testing ? "Testing…" : "Test connection")</button>
                        <button class="btn bs-sync" data-sk disabled="@(!Sync.IsActive(Root))" @onclick="SyncNow">Sync now</button>
                        @if (status.CanAllow) { <button class="btn primary bs-allow" data-sk @onclick="Allow">Allow and sync</button> }
                    </div>
                    <p class="bs-state @(StateClass(status))">@status.Line</p>
                    @if (status.TooLarge is not null) { <p class="muted bs-toolarge">@status.TooLarge</p> }
                    @if (status.SkippedLinks is not null) { <p class="muted bs-skipped">@status.SkippedLinks</p> }
                    @if (status.TrashFolder is not null) { <p class="bs-trash"><button class="bs-open-trash" data-sk @onclick="() => OpenTrash(status.TrashFolder)">Open trash folder</button></p> }
                    @if (testResult is not null) { <p class="bs-test-result @(testResult.Value.Success ? null : "bad")">@testResult.Value.Message</p> }
                </td>
            </tr>
        }
    </tbody>
}

@code {
    [Parameter, EditorRequired] public string Root { get; set; } = "";

    [Inject] private IServiceProvider Services { get; set; } = default!;
    [Inject] private UiService Popups { get; set; } = default!;

    /// <summary>Registered by the desktop host; absent where nothing can be connected (a detached item window, tests).</summary>
    private BoardStorageSettings? Storage => Services.GetService(typeof(BoardStorageSettings)) as BoardStorageSettings;
    private BoardSyncService? Sync => Services.GetService(typeof(BoardSyncService)) as BoardSyncService;

    private static readonly IReadOnlyList<(string Value, string Label)> Modes = [("this", "This folder only"), ("connected", "Connected storage")];
    private IReadOnlyList<(string Value, string Label)> Choices => [.. Storage!.Providers.Select(p => (p.Id, p.Name))];

    private bool testing;
    private string? postponedFor;   // "Not now": the question stays, inert, and is not pressed again; a different question (the address changed) is asked again
    private (bool Success, string Message)? testResult;
    private int generation;   // a new key makes a saved secret's input empty again

    private BoardStorageSettings.StorageView? view;   // the settings as last read: one read of config.yaml per change
    private SyncStatus? lastStatus;                   // the sync line as last worked out: a probe of git and a walk of the board per change, none per drawing
    private string? loadedFor;

    protected override void OnInitialized()
    {
        if (Storage is not null) Storage.Changed += OnSettings;
        if (Sync is not null) Sync.Changed += OnSync;
    }

    protected override void OnParametersSet()
    {
        if (loadedFor != Root) Load();   // opening Settings (or another project): looked at once
    }

    /// <summary>Works out what the section shows. Called when the page opens and when a setting is saved or a sync pass changed something; drawing only reads the result.</summary>
    private void Load()
    {
        loadedFor = Root;
        if (Storage is null || Sync is null) return;
        view = Storage.View(Root);
        lastStatus = Sync.Status(Root);
    }

    private void OnSettings()
    {
        testResult = null;   // an answer belongs to the settings it was asked with
        OnSync();
    }

    private void OnSync() => _ = InvokeAsync(() => { try { Load(); StateHasChanged(); } catch (ObjectDisposedException) { } });

    public void Dispose()
    {
        if (Storage is not null) Storage.Changed -= OnSettings;
        if (Sync is not null) Sync.Changed -= OnSync;
    }

    private string Placeholder(StorageField f) =>
        f.Secret ? (view!.IsSet.Contains(f.Key) ? "Saved on this computer; type to replace" : "Not set on this computer")
        : f.OnThisComputer && view!.Values.GetValueOrDefault(f.Key) is null ? (f.Placeholder.Length > 0 ? f.Placeholder : "Not set on this computer")
        : f.Placeholder;

    private static string? StateClass(SyncStatus s) => s.Line.StartsWith("Failed", StringComparison.Ordinal) || s.Line.StartsWith("Paused", StringComparison.Ordinal) || s.Line.StartsWith("Attachments:", StringComparison.Ordinal) ? "bad" : null;

    private void Report((bool Success, string Message) result)
    {
        if (result.Message.Length > 0) Popups.Toast(result.Message, ToastKind.Warning);   // also a saved value the address rules refuse: it says what to change
    }

    private void Approve() => Report(Storage!.Approve(Root));

    private void SetMode(string mode) =>
        Report(mode == "connected" ? Storage!.Connect(Root, Storage.Providers[0].Id) : Storage!.Disconnect(Root));

    private void SetProvider(string provider) => Report(Storage!.Connect(Root, provider));

    private void SetValue(StorageField field, string? value)
    {
        Report(Storage!.SetValue(Root, field.Key, value));
        if (field.Secret) generation++;
    }

    private async Task TestConnection()
    {
        testing = true;
        testResult = null;
        try { testResult = await Sync!.Test(Root); }
        finally { testing = false; }
    }

    private FolderOpener? Opener => Services.GetService(typeof(FolderOpener)) as FolderOpener;

    private void OpenTrash(string folder)
    {
        if (Opener?.Invoke(folder) is { Success: false, Message: string message }) Popups.Toast(message, ToastKind.Warning);
    }

    private Task SyncNow() => Sync!.SyncNow(Root);

    private Task Allow() => Sync!.SyncNow(Root, allowMassDelete: true);
}
