@namespace TaskManager.Components.Pages
@implements IDisposable
@page "/settings"
@using Notes
@using TaskManager.Api

<ScrollMemory View="settings" />

@{
    string? tabRepo = TabRepo();   // the open project whose tab is chosen, or null: General
}
<div class="sheet settings" data-sk="soft">
    <h2>Settings</h2>
    <div class="settings-tabs"><Seg Name="settings-tab" Options="Tabs" Value="@(tabRepo ?? "general")" ValueChanged="ChooseTab" /></div>

    @if (tabRepo is null)
    {
        <div class="settings-panel" data-setting="general">
            <h3>General</h3>
            <p class="muted set-help">What applies to this computer and to every project. Each project has a tab of its own.</p>
            <table class="set-table">
                <tbody>
                    <tr>
                        <th scope="row">Your name</th>
                        <td>
                            <input class="box text-in" data-sk value="@Settings.Current.Name" placeholder="@Workspace.Me"
                                   @onchange="e => Settings.Update(s => s with { Name = string.IsNullOrWhiteSpace((string?)e.Value) ? null : ((string)e.Value!).Trim() })" aria-label="Your name" />
                            <p class="muted set-note">Used for new work items and notes. Empty = git user.name.</p>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">Theme</th>
                        <td>
                            <Seg Name="theme" Options="Themes" Value="@Settings.Current.Theme" ValueChanged="v => Settings.Update(s => s with { Theme = v })" />
                            <p class="muted set-note">System follows your OS setting.</p>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">Keyboard hints</th>
                        <td>
                            <label class="check"><input type="checkbox" id="f-hints" checked="@Settings.Current.Hints" @onchange="e => Settings.Update(s => s with { Hints = (bool)e.Value! })" /> on</label>
                            <p class="muted set-note">Press F to show a letter on every clickable element, then type it. Shift + the letter selects.</p>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">External editor</th>
                        <td>
                            <input class="box text-in" data-sk value="@Settings.Current.Editor" placeholder="e.g. code"
                                   @onchange="e => Settings.Update(s => s with { Editor = string.IsNullOrWhiteSpace((string?)e.Value) ? null : ((string)e.Value!).Trim() })" aria-label="External editor" />
                            <p class="muted set-note">The command "Edit in …" launches on a note, e.g. code, notepad++, subl. Empty = ask next time.</p>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">Open another repository</th>
                        <td>
                            <div class="set-loc">
                                <input id="f-repo" class="box text-in" data-sk value="@repoPath" placeholder="Path to a repository…" @onchange="e => repoPath = (string?)e.Value ?? string.Empty" aria-label="Repository folder" />
                                @if (Picker is not null) { <button class="btn" data-sk @onclick="Browse">Browse…</button> }
                                <button class="btn primary open-repo" data-sk @onclick="Open">Open</button>
                            </div>
                            <p class="muted set-note">A folder with the openspec/ directory this app reads and writes; one without it is set up for OpenSpec. It joins the projects.</p>
                            @if (error is not null) { <p class="warning">@error</p> }
                        </td>
                    </tr>
                    <tr data-setting="user-settings">
                        <th scope="row">User settings</th>
                        <td>
                            <div class="set-loc"><span class="set-path" title="@Settings.FilePath">@System.IO.Path.GetDirectoryName(Settings.FilePath)</span></div>
                            <div class="set-loc">
                                <input class="box text-in" data-sk value="@settingsFolder" placeholder="Folder to move the settings to…" @onchange="e => settingsFolder = (string?)e.Value ?? string.Empty" aria-label="User settings folder" />
                                @if (Picker is not null) { <button class="btn pick-settings-folder" data-sk @onclick="BrowseSettings">Browse…</button> }
                                <button class="btn primary move-settings" data-sk disabled="@(settingsFolder.Trim().Length == 0)" @onclick="MoveSettings">Move</button>
                            </div>
                            <p class="muted set-note">Your arrangements for each project and these settings, in settings.json on this computer: never in a repository, never synced.</p>
                            @if (Settings.Notice is { } notice) { <p class="warning settings-notice">@notice</p> }
                            @if (settingsMoved is { } moved) { <p class="@(movedOk ? "muted settings-moved" : "warning settings-moved")">@moved</p> }
                        </td>
                    </tr>
                    <tr data-setting="logs-folder">
                        <th scope="row">Logs folder</th>
                        <td>
                            <div class="set-loc">
                                <input class="box text-in" data-sk value="@Settings.Current.LogsDir" placeholder="@AppLog.DefaultFolder" @onchange="e => ApplyLogsFolder((string?)e.Value)" aria-label="Logs folder" />
                                @if (Picker is not null) { <button class="btn pick-logs-folder" data-sk @onclick="ChooseLogsFolder">Choose folder</button> }
                            </div>
                            <div class="att-row att-actions">
                                <button class="btn open-logs-folder" data-sk @onclick="OpenLogsFolder">Open folder</button>
                                <button class="btn open-current-log" data-sk title="Open this run's log file in the default editor" @onclick="OpenCurrentLog">Open current log</button>
                                <button class="btn use-default-logs" data-sk disabled="@(Settings.Current.LogsDir is null)" @onclick="() => ApplyLogsFolder(null)">Use default</button>
                                <button class="btn move-logs" data-sk @onclick="MoveLogs">Move existing logs here</button>
                            </div>
                            <p class="muted set-note">Where the run logs, crash notes and freeze dumps are written. Empty = the app's own folder. A new folder takes effect at once and a new run log starts there; the logs already written stay where they are until you move them.</p>
                            @if (logsNote is { } logsSaid) { <p class="@(logsOk ? "muted set-note logs-note" : "warning logs-note")">@logsSaid</p> }
                        </td>
                    </tr>
                    <tr data-setting="rebuild-index">
                        <th scope="row">Rebuild index</th>
                        <td>
                            @foreach (string project in Workspace.Projects)
                            {
                                <div class="set-loc">
                                    <span class="set-path" title="@project">@ProjectName(project)</span>
                                    <button class="btn rebuild-index" data-sk data-index-of="@ProjectName(project)" @onclick="() => RebuildIndex(project)">Rebuild index</button>
                                </div>
                            }
                            <p class="muted set-note">The app keeps what it read of each project on this computer, so the next start shows the board at once and only reads what changed since. If the board ever looks out of date after a start, rebuild: every file is read again.</p>
                        </td>
                    </tr>
                    <tr class="mcp">
                        <th scope="row">Agents over MCP</th>
                        <td>
                            @if (agents is { } served)
                            {
                                <p class="mcp-status">
                                    <span class="chip @(served.Running ? "on" : null)">@(served.Running ? $"Serving agents · port {served.Port}" : served.ServedByAnotherWindow ? "Another Repo Tasks window serves agents" : "Not serving agents")</span>
                                </p>
                                @if (served.Problem is { } why) { <p class="muted">@why</p> }
                            }
                            <p class="muted set-note">Add this to <code>.mcp.json</code> in a repository so agents use tools instead of editing the board's files. The path is this app's exe on this machine.</p>
                            <pre class="box mcp-snippet" data-sk>@AgentGuide.McpSnippet()</pre>
                            <p class="muted set-note">One line instead: <code>@AgentGuide.McpAddCommand()</code></p>
                        </td>
                    </tr>
                    @if (Updates is { } updates)
                    {
                        <tr data-setting="version">
                            <th scope="row">Version</th>
                            <td>
                                <div class="set-loc">
                                    <span class="version-current">@updates.VersionLabel</span>
                                    <button class="btn check-now" data-sk disabled="@(updates.State is UpdateState.Checking or UpdateState.Downloading)" @onclick="() => _ = updates.CheckAsync()">Check now</button>
                                </div>
                                <p class="@(updates.State == UpdateState.Failed ? "warning" : "muted set-note") version-state">@updates.Summary</p>
                                @if (updates.WhyNot is { } why) { <p class="muted set-note version-why">This copy never updates itself: @why.</p> }
                                else { <p class="muted set-note">On start the app checks the latest release on GitHub and, when it is newer, downloads it and asks to restart.</p> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        string repo = tabRepo;
        string project = ProjectName(repo);
        <div class="settings-panel" data-project="@project">
            <h3>@project</h3>
            <p class="muted set-help">Folders are written relative to the repository and saved with the project. Images stay out of git and sync with the board storage; plans stay in git.</p>
            <table class="set-table">
                <tbody>
                    <tr>
                        <th scope="row">Location</th>
                        <td>
                            <div class="set-loc">
                                <span class="set-path" title="@repo">@repo</span>
                                <button class="btn show-folder" data-sk @onclick="() => ShowInFolder(repo)">Show in folder</button>
                            </div>
                        </td>
                    </tr>
                    @foreach (string kind in Kinds)
                    {
                        <tr data-folder="@kind">
                            <th scope="row">@(kind == PlansKind ? "Plans" : "Images")</th>
                            <td>
                                <div class="set-loc">
                                    <input class="box text-in" data-sk value="@Shown(repo, kind)" placeholder="@DefaultOf(kind)"
                                           @onchange="e => FolderTyped(repo, kind, (string?)e.Value)" aria-label="@(kind == PlansKind ? "Plans" : "Images") folder" />
                                    @if (Picker is not null) { <button class="btn pick-folder" data-sk @onclick="() => Choose(repo, kind)">Choose folder</button> }
                                </div>
                                @if (Pending(repo, kind))
                                {
                                    <div class="att-row att-actions">
                                        <button class="btn primary folder-move" data-sk @onclick="() => Point(repo, kind, true)">Move files here</button>
                                        <button class="btn folder-point" data-sk @onclick="() => Point(repo, kind, false)">Point here</button>
                                    </div>
                                }
                                @if (folderNote is { } note && note.Repo == repo && note.Kind == kind) { <p class="att-row @(note.Warn ? "att-warn" : "att-done muted")">@note.Text</p> }
                            </td>
                        </tr>
                    }
                </tbody>
                <BoardStorageSection Root="@repo" />
                <StatusesSection Root="@repo" />
            </table>
        </div>
    }
</div>

@code {
    [Inject] private SettingsStore Settings { get; set; } = default!;
    [Inject] private Workspace Workspace { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private UiService Popups { get; set; } = default!;
    /// <summary>Native folder dialog, registered by the desktop host (absent in tests).</summary>
    [Inject] private IServiceProvider Services { get; set; } = default!;
    private FolderPicker? Picker => Services.GetService(typeof(FolderPicker)) as FolderPicker;

    /// <summary>Whether this app serves agents (registered by the desktop host; absent in tests that do not need it).</summary>
    private AgentStatus? Status => Services.GetService(typeof(AgentStatus)) as AgentStatus;
    private AgentEndpointStatus? agents;

    /// <summary>The update check (registered by the desktop host; absent in tests that do not need it).</summary>
    private AppUpdates? Updates => Services.GetService(typeof(AppUpdates)) as AppUpdates;

    protected override void OnInitialized()
    {
        agents = Status?.Invoke();
        if (Updates is { } updates) updates.Changed += UpdatesChanged;
    }

    private void UpdatesChanged() => _ = InvokeAsync(StateHasChanged);   // the check runs on the pool

    public void Dispose()
    {
        if (Updates is { } updates) updates.Changed -= UpdatesChanged;
    }

    private static readonly IReadOnlyList<(string, string)> Themes = [("light", "Light"), ("dark", "Dark"), ("system", "System")];

    // ── the tabs: General, then one per open project; the chosen one is the window's own state (UiService), kept when the user comes back ──

    private static string ProjectName(string repo) => System.IO.Path.GetFileName(repo.TrimEnd('\\', '/'));

    private IReadOnlyList<(string Value, string Label)> Tabs => [("general", "General"), .. Workspace.OpenRepos.Select(r => (r, ProjectName(r)))];

    /// <summary>The open project whose tab is chosen; null for General, also when the chosen project is no longer open.</summary>
    private string? TabRepo() => Popups.SettingsTab == "general" ? null : Workspace.OpenRepos.FirstOrDefault(r => SettingsStore.Key(r) == SettingsStore.Key(Popups.SettingsTab));

    private void ChooseTab(string tab) => Popups.SettingsTab = tab;

    // ── the plans and images folders: each is typed or chosen, then moved to (the files go along) or pointed at (only the setting changes) ──

    private const string PlansKind = "plans", ImagesKind = "images";
    private static readonly string[] Kinds = [PlansKind, ImagesKind];
    private sealed record FolderNote(string Repo, string Kind, string Text, bool Warn);
    private readonly Dictionary<string, string> typed = [];   // what was typed or chosen and not yet moved to or pointed at, by repo and kind
    private FolderNote? folderNote;

    private static string TypedKey(string repo, string kind) => repo + "|" + kind;
    private static string DefaultOf(string kind) => kind == PlansKind ? SettingsStore.DefaultPlansDir : SettingsStore.DefaultAttachmentsDir;
    private string CurrentOf(string repo, string kind) => kind == PlansKind ? Settings.PlansDir(repo) : Settings.AttachmentsDir(repo);
    private string Shown(string repo, string kind) => typed.GetValueOrDefault(TypedKey(repo, kind)) ?? CurrentOf(repo, kind);
    private bool Pending(string repo, string kind) => typed.ContainsKey(TypedKey(repo, kind));

    /// <summary>A path inside the repository, written relative to it: what the folder dialog returns is absolute, and so may be what was typed. Anything else is left for the check to refuse.</summary>
    private static string Relative(string repo, string text)
    {
        text = text.Trim();
        if (!System.IO.Path.IsPathRooted(text)) return text;
        string relative = System.IO.Path.GetRelativePath(repo, text);
        return relative.StartsWith("..") || System.IO.Path.IsPathRooted(relative) ? text : relative;
    }

    private (bool Ok, string Dir, string Why) Target(string repo, string kind) =>
        typed[TypedKey(repo, kind)] is { } text && text.Trim().Length > 0 ? NotesApi.CheckAttachmentsDir(Relative(repo, text)) : (true, DefaultOf(kind), "");   // empty = the default

    private void FolderTyped(string repo, string kind, string? text)
    {
        folderNote = null;
        typed[TypedKey(repo, kind)] = text ?? "";
        if (Target(repo, kind) is { Ok: true } same && same.Dir == CurrentOf(repo, kind)) typed.Remove(TypedKey(repo, kind));   // back to where it is: nothing to do
    }

    private void Choose(string repo, string kind)
    {
        if (Picker?.Invoke($"Choose the {kind} folder") is string chosen) FolderTyped(repo, kind, Relative(repo, chosen));
    }

    private void Point(string repo, string kind, bool move)
    {
        if (!Pending(repo, kind)) return;
        (bool ok, string dir, string why) = Target(repo, kind);
        if (!ok) { folderNote = new(repo, kind, why, true); return; }
        string old = CurrentOf(repo, kind), said = "";
        bool imagesMoved = false;
        if (move)
        {
            Notes.PublicDTOs.AttachmentsMoveResult result = Workspace.In(repo, () => kind == PlansKind ? NotesApi.MovePlans(repo, old, dir) : NotesApi.MoveAttachments(repo, old, dir));
            if (!result.Success) { folderNote = new(repo, kind, result.Message, true); return; }   // nothing was moved: the old place stays in use
            (said, imagesMoved) = (result.Message, result.Moved + result.Duplicates > 0);
        }
        if (kind == ImagesKind) Workspace.AttachmentsFolderChangingHere(repo, dir, imagesMoved);   // before the write: the sync service must not take this change for a pull's and move the files a second time
        (bool saved, string message) = kind == PlansKind ? Settings.SetPlansDir(repo, dir) : Settings.SetAttachmentsDir(repo, dir);
        if (!saved)
        {
            folderNote = new(repo, kind, message, true);
            if (kind == ImagesKind) Workspace.AttachmentsFolderChangingHere(repo, Settings.AttachmentsDir(repo), false);
            return;
        }
        typed.Remove(TypedKey(repo, kind));
        folderNote = new(repo, kind, said.Length > 0 ? said : $"Pointing at {dir}.", false);
        Workspace.Notify();   // notes, descriptions and plan links may have been rewritten: every open page reads them again
    }

    private string repoPath = "";
    private string? error;

    private string settingsFolder = "";
    private string? settingsMoved;
    private bool movedOk;

    private void BrowseSettings()
    {
        if (Picker?.Invoke("Choose a folder for your user settings") is string chosen) settingsFolder = chosen;
    }

    private void MoveSettings()
    {
        (movedOk, settingsMoved) = Settings.MoveTo(settingsFolder);
        if (movedOk) settingsFolder = "";
    }

    // ── the logs folder: typed or chosen, it applies at once (the run log moves, the setting is saved); the logs already written move only when asked ──

    private string? logsNote;
    private bool logsOk;

    private void ApplyLogsFolder(string? text)
    {
        string? wanted = string.IsNullOrWhiteSpace(text) ? null : text.Trim();
        (string folder, string? warning) = Paths.LogsFor(wanted);
        if (warning is not null) { (logsOk, logsNote) = (false, warning); return; }   // a folder that is not there or cannot be written changes nothing
        (bool ok, string message) = AppLog.SwitchFolder(wanted is null ? null : folder);
        (logsOk, logsNote) = (ok, message);
        if (ok) Settings.SetLogsDir(wanted is null ? null : folder);
    }

    private void ChooseLogsFolder()
    {
        if (Picker?.Invoke("Choose the folder for the logs") is string chosen) ApplyLogsFolder(chosen);
    }

    private void OpenLogsFolder()
    {
        if (FolderOpener?.Invoke(AppLog.Folder) is { Success: false, Message: string message }) Popups.Toast(message, ToastKind.Warning);
    }

    /// <summary>Opens this run's log file with the OS default handler, through the same seam that shows a folder (the file manager is the default handler of a folder, the editor of a .log).</summary>
    private void OpenCurrentLog()
    {
        if (AppLog.CurrentFile is not string file) { Popups.Toast("This run has no log file.", ToastKind.Warning); return; }
        if (FolderOpener?.Invoke(file) is { Success: false, Message: string message }) Popups.Toast(message, ToastKind.Warning);
    }

    private void MoveLogs() => (logsOk, logsNote, _) = AppLog.MoveExistingLogs();

    private void RebuildIndex(string repo)
    {
        Workspace.RebuildIndex(repo);
        Popups.Toast($"Rebuilt the index of {ProjectName(repo)}.");
    }

    private FolderOpener? FolderOpener => Services.GetService(typeof(FolderOpener)) as FolderOpener;

    private void ShowInFolder(string repo)
    {
        if (FolderOpener?.Invoke(repo) is { Success: false, Message: string message }) Popups.Toast(message, ToastKind.Warning);
    }

    private void Browse()
    {
        if (Picker?.Invoke() is string chosen) { repoPath = chosen; Open(); }
    }

    private void Open()
    {
        (bool ok, string message) = Workspace.OpenTab(repoPath);
        error = ok ? null : message;
        if (ok && Workspace.TakeGuideNotice() is string notice) Popups.Toast(notice, ToastKind.Info);
        if (ok) Nav.NavigateTo("");
    }
}
