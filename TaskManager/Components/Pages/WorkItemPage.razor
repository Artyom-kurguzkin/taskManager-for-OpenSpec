@page "/item/{Id:int}"
@using GitHistory
@using GitHistory.PublicDTOs
@using Notes
@using Notes.PublicDTOs
@using WorkItems
@using WorkItems.PublicDTOs
@inherits RepoPage

@if (item is null)
{
    <NotFound What="@($"#wi{Id}")">It may have been merged or deleted.</NotFound>
    return;
}

<div class="sheet" data-sk="soft">
    <div class="head">
        <h2 class="num">#wi@(item.Id)</h2>
        <input class="title-in hov" data-sk value="@item.Title" aria-label="Title"
               @onchange="e => Run(WorkItemsApi.SetTitle(item.Id, (string)e.Value!))" />
        @if (item.Hidden)
        {
            <button class="btn ghost hide-item" title="Shows it on the board again" @onclick="() => Run(WorkItemsApi.Unhide(item.Id))">Restore</button>
        }
        <BackButton />
    </div>
    @if (item.Hidden) { <p class="warning">Hidden from the board. Restore it to show it again; nothing was removed from openspec/.</p> }
    <div class="head kvs">
        <div class="kv"><label>linked features</label>
            @foreach (FeatureLink f in item.Features)
            {
                <span class="chip x @(f.Locked ? "spec" : "")" title="@(f.Locked ? "From the change's specs/ folder. Remove hides it here; the spec stays." : "Remove")"
                      @onclick="() => RemoveFeature(f)">@Workspace.FeatureNames.GetValueOrDefault(f.Path, f.Path)</span>
            }
            <Dropdown Label="add feature" Class="mini" Placeholder="+ add" Options="FeatureChoices" ValueChanged="AddFeature" />
        </div>
        <div class="kv contributors"><label>contributors</label>
            @foreach (string p in item.Contributors)
            {
                <span class="chip x" title="Remove" @onclick="() => Run(WorkItemsApi.SetContributors(item.Id, item.Contributors.Where(x => x != p)))">@p</span>
            }
            @* known people, or any name typed in the filter *@
            <PickerMenu TItem="string" Label="Add a contributor" ButtonClass="box dd mini" Boxed Placeholder="Type a name…" Items="PeopleChoices" Text="p => [p]"
                        OnPick="AddContributor" OnTyped="AddContributor"><ItemTemplate Context="p">@p</ItemTemplate></PickerMenu>
        </div>
        <div class="kv status-field"><label>status</label><Pill Kind="status" Value="@item.Status" ReadOnly="item.Archived" ValueChanged="SetStatus" /></div>
        <div class="kv"><label>priority</label><Pill Kind="priority" Value="@item.Priority" ValueChanged="v => Run(WorkItemsApi.SetPriority(item.Id, v))" /></div>
        <div class="kv"><label>label</label><Pill Kind="label" Value="@(item.Label ?? "")" ValueChanged="v => Run(WorkItemsApi.SetLabel(item.Id, v))" /></div>
    </div>
    @if (item.Warning is not null) { <p class="warning">@item.Warning</p> }

    @* Bento: every list is a tile of the same rank. The focused tile is large and fully editable (the description by
       default); the others are compact previews of their last few entries, and clicking one focuses it. *@
    <div class="bento" style="--rows:@(Blocking.Count > 0 ? 5 : 4)">
        <section class="tile @Focused("description")" data-tile="description" @onclick="@(() => FocusTile("description"))">
            @Head("description", "Description", null)
            @if (focus != "description")
            {
                <div class="peek-desc">@if (string.IsNullOrWhiteSpace(description)) { <span class="muted">No description yet</span> } else { @Ui.Markdown(description) }</div>
            }
            else if (editingDescription)
            {
                <textarea @ref="descriptionBox" class="desc-in" rows="14" @bind="description" @onblur="SaveDescription" aria-label="Description"></textarea>
            }
            else
            {
                <div class="desc edit hov" data-sk tabindex="0" @onclick="EditDescription">
                    @if (string.IsNullOrWhiteSpace(description)) { <span class="muted">Click to add a description</span> }
                    else { @Ui.Markdown(description) }
                </div>
            }
        </section>

        <section class="tile @Focused("subtasks")" data-tile="subtasks" @onclick="@(() => FocusTile("subtasks"))">
            @Head("subtasks", "Subtasks", $"{item.Subtasks.Count(s => s.Done)}/{item.Subtasks.Count}")
            @if (focus != "subtasks")
            {
                <span class="prog wide"><i style="width:@(item.Subtasks.Count == 0 ? 0 : item.Subtasks.Count(s => s.Done) * 100 / item.Subtasks.Count)%"></i></span>
                @foreach (Subtask s in PeekSubtasks) { <div class="peek @(s.Done ? "done" : "")"><span class="mono">@s.Number</span><span class="t">@s.Text</span></div> }
                @foreach (WorkItem d in WaitingOn.Where(d => !WorkItemsApi.IsResolved(d)).Take(2)) { <div class="peek waits"><span class="mono">waits on</span><span class="t">#wi@(d.Id) · @d.Title</span></div> }
                @if (item.Subtasks.Count == 0 && WaitingOn.Count == 0) { <p class="muted">No subtasks yet.</p> }
            }
            else
            {
                <div>
                    @foreach (Subtask s in item.Subtasks)
                    {
                        <div class="sub @(s.Done ? "done" : "") @(subSel.Contains(s.Number) ? "selected" : "")" data-sk>
                            <input type="checkbox" id="sub-@s.Number.Replace('.', '-')" checked="@s.Done"
                                   @onchange="e => Run(WorkItemsApi.SetSubtaskDone(item.Id, s.Number, (bool)e.Value!))" aria-label="Done" />
                            <span class="mono">@s.Number</span>
                            @if (editingSub == s.Number)
                            {
                                @* Enter or leaving the box saves, Esc cancels *@
                                <input @ref="subBox" class="sub-edit" data-own-esc value="@s.Text" aria-label="Subtask @s.Number" @oninput="e => subText = (string)e.Value!"
                                       @onkeydown="e => SubKey(e, s)" @onblur="() => SaveSub(s)" />
                            }
                            else
                            {
                                @* click edits it; Shift/Ctrl/⌘-click selects it, as cards on the board *@
                                <span class="s-t" title="Click to edit · Shift-click to select" @onclick="e => SubClick(e, s)">@s.Text</span>
                            }
                        </div>
                    }
                    @* items this one waits on (struck through once in review or done, so they no longer block) *@
                    @foreach (WorkItem d in WaitingOn)
                    {
                        bool done = WorkItemsApi.IsResolved(d);
                        <div class="sub dep waits @(done ? "done" : "blocking-me")" data-sk @onclick="@(() => Nav.NavigateTo($"item/{d.Id}"))">
                            <span class="dep-k">waits on</span><span class="s-t">#wi@(d.Id) · @d.Title</span><span class="dep-s">@d.Status</span>
                            <button class="ic" aria-label="Remove dependency" title="Remove dependency" @onclick:stopPropagation="true"
                                    @onclick="() => Run(WorkItemsApi.RemoveDependency(item.Id, d.Id))">×</button>
                        </div>
                    }
                </div>
                <form class="add-line" @onsubmit="AddSubtask" @onsubmit:preventDefault="true">
                    <input @bind="newSubtask" placeholder="Add a subtask, or #wi12…" aria-label="New subtask" /><button class="btn" data-sk type="submit">add</button>
                </form>
                @if (!item.Archived)
                {
                    @* an existing work item this one has to wait on (typing its id above does the same) *@
                    <PickerMenu TItem="WorkItem" Label="Wait on another work item" ButtonText="+ wait on another work item" Placeholder="Filter work items…"
                                Items="DependencyChoices" Text="@(w => [$"#wi{w.Id}", w.Title, w.Status])" OnPick="w => LinkDependency(w.Id)">
                        <ItemTemplate Context="w"><span class="mono">#wi@(w.Id)</span> @w.Title <span class="muted">· @w.Status</span></ItemTemplate>
                    </PickerMenu>
                }
                @if (!item.Archived) { <span class="muted">Type another item's id (#wi12) to wait on it. Click a subtask to edit it. Shift-click to select it (or several), then make it a work item of its own.</span> }
            }
        </section>

        @if (Blocking.Count > 0)
        {
            <section class="tile @Focused("blocks")" data-tile="blocks" @onclick="@(() => FocusTile("blocks"))">
                @Head("blocks", "Waiting on this", Blocking.Count.ToString())
                @foreach (WorkItem b in focus == "blocks" ? Blocking : Blocking.Take(3))
                {
                    @if (focus == "blocks")
                    {
                        <div class="sub dep blocks" data-sk @onclick="@(() => Nav.NavigateTo($"item/{b.Id}"))">
                            <span class="dep-k">blocks</span><span class="s-t">#wi@(b.Id) · @b.Title</span><span class="dep-s">@b.Status</span>
                        </div>
                    }
                    else { <div class="peek"><span class="mono">#wi@(b.Id)</span><span class="t">@b.Title</span></div> }
                }
            </section>
        }

        <section class="tile @Focused("commits")" data-tile="commits" @onclick="@(() => FocusTile("commits"))">
            @Head("commits", "Linked commits", commits.Count > 0 ? commits.Count.ToString() : null)
            @if (focus != "commits")
            {
                @foreach (CommitInfo c in commits.Take(3)) { <div class="peek"><span class="mono">@c.Hash</span><span class="t">@c.Subject</span></div> }
                @if (commits.Count == 0) { <p class="muted">@(GitHistoryApi.IsRepository() ? $"None yet. Mention #wi{item.Id} in a commit." : "Not a git repository.")</p> }
            }
            else
            {
                @* commits that mention #wiN (from git) plus ones picked by hand (x-rtm.commits, removable) *@
                <div class="linked-commits">
                    @if (!GitHistoryApi.IsRepository()) { <p class="muted">Not a git repository, so there are no commits to show.</p> }
                    else if (commits.Count == 0) { <p class="muted">Commits that mention #wi@(item.Id), or that you link here, show up here.</p> }
                    @foreach (CommitInfo c in commits)
                    {
                        bool picked = (item.Commits ?? []).Contains(c.Hash);
                        <div class="commit hov" data-sk tabindex="0"><span class="mono">@c.Hash</span><span>@c.Subject</span>
                            @if (picked) { <button class="ic" aria-label="Unlink commit" title="Unlink" @onclick="() => Run(WorkItemsApi.SetLinkedCommits(item.Id, item.Commits!.Where(h => h != c.Hash)))">×</button> }</div>
                    }
                    @if (GitHistoryApi.IsRepository())
                    {
                        <PickerMenu TItem="CommitInfo" Label="Link a commit" ButtonText="+ link commit" Placeholder="Filter commits…"
                                    Items="GitHistoryApi.Recent(50).Where(c => commits.All(x => x.Hash != c.Hash))" Text="c => [c.Hash, c.Subject, c.Author]"
                                    OnPick="c => Run(WorkItemsApi.SetLinkedCommits(item.Id, [.. item.Commits ?? [], c.Hash]))">
                            <ItemTemplate Context="c"><span class="mono">@c.Hash</span> @c.Subject <span class="muted">· @c.Author</span></ItemTemplate>
                        </PickerMenu>
                    }
                </div>
            }
        </section>

        <section class="tile @Focused("tests")" data-tile="tests" @onclick="@(() => FocusTile("tests"))">
            @Head("tests", "Linked tests", TestsSummary)
            @if (focus != "tests")
            {
                @foreach (TestLink t in (item.Tests ?? []).OrderBy(t => Outcome(t) == "failed" ? 0 : 1).Take(3)) { <div class="peek test-@Outcome(t)"><span class="dot" aria-label="@Outcome(t)"></span><span class="t">@t.Test</span></div> }
                @if ((item.Tests ?? []).Count == 0) { <p class="muted">@(run.File is null ? "No test results file configured." : "None linked yet.")</p> }
            }
            else
            {
                @* tests picked from the newest results file (x-rtm.tests), each with its last result and an optional note *@
                <div class="linked-tests">
                    @foreach (IGrouping<string, TestLink> suite in (item.Tests ?? []).GroupBy(t => t.Suite))
                    {
                        List<string> outcomes = suite.Select(Outcome).ToList();
                        <div class="suite-h"><b>@suite.Key</b>
                            <span class="muted">@(run.Results.Where(r => r.Suite == suite.Key).Max(r => r.Finished) is DateTime ran ? $"· last ran {ran.ToLocalTime():d.M.yyyy HH:mm}" : "")
                                · @(outcomes.Count(o => o == "failed") is int failed and > 0 ? $"{failed} failed" : outcomes.All(o => o == "passed") ? "all passed" : "not all run")</span></div>
                        @foreach (TestLink t in suite)
                        {
                            <div class="test @Outcome(t)">
                                @if (t.Note is int note) { <button class="row-title" @onclick="@(() => Nav.NavigateTo($"note/{note}"))">@t.Test</button> } else { <span>@t.Test</span> }
                                <span class="muted">@Outcome(t)</span>
                                @if (t.Note is null) { <button class="add" aria-label="Add a note for this test" @onclick="() => AddTestNote(t)">+ note</button> }
                                <button class="ic" aria-label="Unlink test" title="Unlink" @onclick="() => Run(WorkItemsApi.SetLinkedTests(item.Id, item.Tests!.Where(x => x != t)))">×</button>
                            </div>
                        }
                    }
                    @if (run.File is null) { <p class="muted">@(run.Globs.Count == 0 ? "No test results configured: list result files under x-rtm.testResults in openspec/config.yaml." : $"No results file found at {string.Join(", ", run.Globs)}.")</p> }
                    @if (run.File is not null)
                    {
                        <PickerMenu TItem="LinkedTestRuns.PublicDTOs.TestResult" Label="Link a test" ButtonText="+ link test" Placeholder="Filter tests…"
                                    Items="UnlinkedTests" Text="r => [r.Suite, r.Test]"
                                    OnPick="r => Run(WorkItemsApi.SetLinkedTests(item.Id, [.. item.Tests ?? [], new TestLink(r.Suite, r.Test, null)]))">
                            <ItemTemplate Context="r"><span class="muted">@r.Suite /</span> @r.Test</ItemTemplate>
                        </PickerMenu>
                    }
                </div>
            }
        </section>

        @* the work item's notes are its change log entries (newest first) *@
        <section class="tile @Focused("log")" data-tile="log" @onclick="@(() => FocusTile("log"))">
            @Head("log", "Change log", notes.Count > 0 ? notes.Count.ToString() : null)
            @if (focus != "log")
            {
                @foreach (Note n in notes.Take(3)) { <div class="peek"><span class="mono">@n.Created.ToString("d.M")</span><span class="t">@n.Title</span></div> }
                @if (notes.Count == 0) { <p class="muted">No entries yet.</p> }
            }
            else
            {
                <div class="change-log">
                    @foreach (Note n in notes)
                    {
                        <button class="log-e hov" data-sk @onclick="@(() => Nav.NavigateTo($"note/{n.Id}"))"><b>#n@(n.Id) · @n.Title</b><span class="muted">@n.Created.ToString("d.M.yyyy") · @n.By</span></button>
                    }
                    @if (notes.Count == 0) { <p class="muted">No entries yet.</p> }
                </div>
                <button class="add" @onclick="AddNote">+ Add entry</button>
            }
        </section>
    </div>
</div>

@if (subSel.Count >= 1)
{
    <div class="actionbar" data-sk>
        <span class="n">@subSel.Count subtask@(subSel.Count == 1 ? "" : "s")</span>
        <button class="btn primary" data-sk @onclick="MoveSubtasks">@(subSel.Count == 1 ? "Make it a work item" : "Move into a separate work item")</button>
        <button class="btn dep" data-sk @onclick="MoveSubtasksAsDependency" title="Creates a new work item and blocks this one until it's done">Make it a dependency</button>
        <button class="btn ghost" @onclick="() => subSel.Clear()">Clear</button>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Inject] private IJSRuntime Js { get; set; } = default!;

    private WorkItem? item;
    private string description = "";
    private bool editingDescription;
    private string newSubtask = "";
    private IReadOnlyList<CommitInfo> commits = [];
    private IReadOnlyList<Note> notes = [];
    private LinkedTestRuns.PublicDTOs.TestRun run = new(null, [], []);
    private readonly HashSet<string> subSel = [];

    /// <summary>Results in the newest run that are not linked yet, by suite and name.</summary>
    private IEnumerable<LinkedTestRuns.PublicDTOs.TestResult> UnlinkedTests => run.Results
        .Where(r => !(item!.Tests ?? []).Any(t => t.Suite == r.Suite && t.Test == r.Test))
        .OrderBy(r => r.Suite, StringComparer.OrdinalIgnoreCase).ThenBy(r => r.Test, StringComparer.OrdinalIgnoreCase);

    /// <summary>A linked test's outcome in the newest results file: passed, failed, skipped, or "no result".</summary>
    private string Outcome(TestLink t) => run.Results.FirstOrDefault(r => r.Suite == t.Suite && r.Test == t.Test)?.Outcome ?? "no result";

    private IReadOnlyList<(string, string)> FeatureChoices =>
        Features.FeaturesApi.GetAll().Where(f => item!.Features.All(x => x.Path != f.Path)).Select(f => (f.Path, $"{f.Group} · {f.Name}")).ToList();

    private IReadOnlyList<string> PeopleChoices =>
        GitHistoryApi.AllAuthors().Concat(WorkItemsApi.GetAll().SelectMany(w => w.Contributors)).Append(Workspace.Me)
            .Select(GitHistoryApi.PersonName).Distinct().Except(item!.Contributors.Select(GitHistoryApi.PersonName))
            .Order(StringComparer.OrdinalIgnoreCase).ToList();

    private void AddContributor(string person) => Run(WorkItemsApi.SetContributors(Id, item!.Contributors.Append(person)));

    protected override void Load()
    {
        item = WorkItemsApi.Get(Id);
        if (item is null) return;
        if (!editingDescription) description = WorkItemsApi.GetDescription(Id);
        notes = NotesApi.GetForWorkItem(Id).OrderByDescending(n => n.Created).ThenByDescending(n => n.Id).ToList();
        commits = [.. (item.MergedFrom ?? []).Prepend(Id).SelectMany(n => GitHistoryApi.Mentioning($"#wi{n}")).Concat(GitHistoryApi.Commits(item.Commits ?? [])).DistinctBy(c => c.Hash)];   // a merged item also owns what mentions its sources
        run = LinkedTestRuns.LinkedTestRunsApi.Latest();
        subSel.IntersectWith(item.Subtasks.Select(s => s.Number));
    }

    private async Task SetStatus(string status)
    {
        if (status == "Completed" && item is { Archived: false })
        {
            if (!await Popups.Confirm("Complete and archive?",
                $"#wi{item.Id} will be archived with the OpenSpec CLI and its delta specs merged into openspec/specs.", yes: "Archive")) return;
            Run(await Popups.Busy($"Archiving #wi{item.Id} with the OpenSpec CLI…", () => WorkItemsApi.SetStatus(Id, status)));
            return;
        }
        Run(WorkItemsApi.SetStatus(Id, status));
    }

    // a feature from specs/ comes back by relinking it; any other is added to x-rtm.features
    private void AddFeature(string path) => Run(item!.UnlinkedFeatures?.Contains(path) == true
        ? WorkItemsApi.RelinkFeature(Id, path)
        : WorkItemsApi.SetManualFeatures(Id, item.Features.Select(f => f.Path).Append(path)));
    private void RemoveFeature(FeatureLink f) => Run(f.Locked
        ? WorkItemsApi.UnlinkFeature(Id, f.Path)
        : WorkItemsApi.SetManualFeatures(Id, item!.Features.Select(x => x.Path).Where(p => p != f.Path)));

    private ElementReference descriptionBox;
    private bool focusDescription;

    // ── Bento: one focused tile, the rest compact ──
    private string? focus = "description";   // null: every tile minimised (narrow windows only)
    private bool narrow;

    private async Task<bool> IsNarrow()
    {
        try { return await Js.InvokeAsync<bool>("rtm.isNarrow"); }
        catch (JSException) { return false; }
    }

    private string Focused(string tile) => focus == tile ? "focus" : "";

    /// <summary>A tile header: focuses a compact tile; on a narrow window it also minimises the open one (desktop keeps one open).</summary>
    private void HeaderClick(string tile)
    {
        if (focus != tile) FocusTile(tile);
        else if (narrow) { if (editingDescription) SaveDescription(); focus = null; }
    }

    /// <summary>Clicking a compact tile focuses it. Leaving the description saves it first (its textarea blur may not fire).</summary>
    private void FocusTile(string tile)
    {
        if (focus == tile) return;
        if (editingDescription) SaveDescription();
        focus = tile;
    }

    /// <summary>A tile's header: its name and count. On a compact tile it is the button that focuses it.</summary>
    private RenderFragment Head(string tile, string title, string? count) => __builder =>
    {
        @* its own click (not the tile's), so on a narrow window the open tile's header can minimise it *@
        bool open = focus == tile;
        <button type="button" class="tile-h" aria-expanded="@open" aria-label="@(open ? (narrow ? $"Minimise {title}" : title) : $"Show {title}")" tabindex="@(open && !narrow ? -1 : 0)"
                @onclick="() => HeaderClick(tile)" @onclick:stopPropagation="true">
            <h3>@title</h3>
            @if (count is not null) { <span class="count">@count</span> }
            @if (!open || narrow) { <span class="open" aria-hidden="true">@Ui.Icon(open ? "collapse" : "expand")</span> }
        </button>
    };

    /// <summary>Compact subtasks: the next three still open, or the last three when all are done.</summary>
    private IEnumerable<Subtask> PeekSubtasks =>
        item!.Subtasks.Any(s => !s.Done) ? item.Subtasks.Where(s => !s.Done).Take(3) : item.Subtasks.TakeLast(3);

    private string? TestsSummary => (item?.Tests ?? []) is { Count: > 0 } tests
        ? tests.Count(t => Outcome(t) == "failed") is int failed and > 0 ? $"{failed} failed" : $"{tests.Count}"
        : null;

    private void EditDescription()
    {
        if (item is null) return;
        editingDescription = focusDescription = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Narrow windows (one-column bento) open with every tile minimised; desktop keeps the description open.
        if (firstRender && await IsNarrow()) { narrow = true; focus = null; StateHasChanged(); }
        if (focusSub) { focusSub = false; try { await subBox.FocusAsync(); } catch (InvalidOperationException) { } }
        if (!focusDescription) return;
        focusDescription = false;
        await descriptionBox.FocusAsync();
    }

    private void SaveDescription()
    {
        editingDescription = false;
        Run(WorkItemsApi.SetDescription(Id, description));
    }

    private void ToggleSub(string number)
    {
        if (!subSel.Remove(number)) subSel.Add(number);
    }

    // ── Editing a subtask's text in place ──
    private string? editingSub;   // number of the subtask being edited
    private string subText = "";
    private ElementReference subBox;
    private bool focusSub;

    private void SubClick(MouseEventArgs e, Subtask s)
    {
        if (e.ShiftKey || e.CtrlKey || e.MetaKey) { ToggleSub(s.Number); return; }
        editingSub = s.Number;
        subText = s.Text;
        focusSub = true;
    }

    private void SubKey(KeyboardEventArgs e, Subtask s)
    {
        if (e.Key == "Enter") SaveSub(s);
        else if (e.Key == "Escape") editingSub = null;
    }

    /// <summary>Saves on Enter or blur; an unchanged text writes nothing. Blank text is refused with a message.</summary>
    private void SaveSub(Subtask s)
    {
        if (editingSub != s.Number) return;   // already saved by Enter, or cancelled by Esc
        editingSub = null;
        if (subText.Trim() != s.Text) Run(WorkItemsApi.SetSubtaskText(Id, s.Number, subText));
    }

    // "#wi12", "wi12" or "12" names another work item: wait on it instead of adding a subtask line.
    private void AddSubtask()
    {
        if (System.Text.RegularExpressions.Regex.Match(newSubtask.Trim(), @"^#?(?:wi)?(\d+)$", System.Text.RegularExpressions.RegexOptions.IgnoreCase) is { Success: true } m)
        {
            LinkDependency(int.Parse(m.Groups[1].Value));
        }
        else Run(WorkItemsApi.AddSubtask(Id, newSubtask));
        newSubtask = "";
    }

    /// <summary>Active work items this one could wait on: not itself, not already waited on, and not one that waits on this (a loop).</summary>
    private IEnumerable<WorkItem> DependencyChoices =>
        WorkItemsApi.GetAll(includeHidden: false).Where(w => !w.Archived && w.Id != Id && !(item!.DependsOn ?? []).Contains(w.Id) && !(w.DependsOn ?? []).Contains(Id));

    private void LinkDependency(int dep)
    {
        (bool ok, string message) = WorkItemsApi.AddDependency(Id, dep);
        Run((ok, message));
        if (ok) Popups.Toast(WorkItemsApi.Get(dep) is { } d && WorkItemsApi.IsResolved(d)
            ? $"Linked #wi{dep} — it's already {(d.Archived ? "Completed" : d.Status)}, so it doesn't block this item"
            : $"Waiting on #wi{dep} — this item is Blocked until it's in review or done", ToastKind.Success);
    }

    private void MoveSubtasks()
    {
        (bool ok, string message, int newId) = WorkItemsApi.MoveSubtasksToNew(Id, subSel.ToList());
        subSel.Clear();
        Run((ok, message));
        if (ok) Popups.Toast($"Moved into #wi{newId}", ToastKind.Success);
    }

    private void MoveSubtasksAsDependency()
    {
        (bool ok, string message, int newId) = WorkItemsApi.MoveSubtasksToDependency(Id, subSel.ToList());
        subSel.Clear();
        Run((ok, message));
        if (ok) Popups.Toast($"#wi{newId} created — this item is now blocked on it", ToastKind.Success);
    }

    /// <summary>Items this one is waiting on before it can leave Blocked.</summary>
    private IReadOnlyList<WorkItem> WaitingOn => item is null ? [] : (item.DependsOn ?? []).Select(WorkItemsApi.Get).OfType<WorkItem>().ToList();
    /// <summary>Items whose x-rtm.dependsOn names this one.</summary>
    private IReadOnlyList<WorkItem> Blocking => item is null ? [] : WorkItemsApi.GetBlocking(item.Id);

    // A note describing the test (what a developer or Playwright checks), attached to the link and opened for writing.
    private void AddTestNote(TestLink t)
    {
        (bool ok, string message, int noteId) = NotesApi.Create(Id, Workspace.Me);
        if (!ok || !WorkItemsApi.SetLinkedTests(Id, item!.Tests!.Select(x => x == t ? x with { Note = noteId } : x)).Success) { Popups.Toast(message, ToastKind.Warning); return; }
        Nav.NavigateTo($"note/{noteId}");
        Workspace.Notify();
    }

    private void AddNote()
    {
        (bool ok, string message, int noteId) = NotesApi.Create(Id, Workspace.Me);
        if (!ok) { Popups.Toast(message, ToastKind.Warning); return; }
        Nav.NavigateTo($"note/{noteId}");   // open it first; refreshing other views must not get in the way
        Workspace.Notify();
    }

}
