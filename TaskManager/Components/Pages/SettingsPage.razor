@page "/settings"

<div class="sheet settings" data-sk="soft">
    <h2>Settings</h2>

    <section class="set-row">
        <div><h3>Theme</h3><p class="muted">System follows your OS setting.</p></div>
        <Seg Name="theme" Options="Themes" Value="@Settings.Current.Theme" ValueChanged="v => Settings.Update(s => s with { Theme = v })" />
    </section>

    <section class="set-row">
        <div><h3>Repository</h3><p class="muted">Folder with the openspec/ directory this app reads and writes.</p></div>
        <div class="set-val">
            <input id="f-repo" class="box text-in" data-sk value="@repoPath" @onchange="e => repoPath = (string?)e.Value ?? string.Empty" aria-label="Repository folder" />
            @if (Picker is not null) { <button class="btn" data-sk @onclick="Browse">Browse…</button> }
            <button class="btn primary open-repo" data-sk @onclick="Open">Open</button>
        </div>
    </section>
    @if (error is not null) { <p class="warning">@error</p> }

    <section class="set-row">
        <div><h3>Your name</h3><p class="muted">Used for new work items and notes. Empty = git user.name.</p></div>
        <div class="set-val"><input class="box text-in" data-sk value="@Settings.Current.Name" placeholder="@Workspace.Me"
                                    @onchange="e => Settings.Update(s => s with { Name = string.IsNullOrWhiteSpace((string?)e.Value) ? null : ((string)e.Value!).Trim() })" aria-label="Your name" /></div>
    </section>

    <section class="set-row">
        <div><h3>Default board view</h3><p class="muted">What the board shows when you open a repository for the first time.</p></div>
        <Seg Name="defview" Options="Views" Value="@Settings.Current.DefaultView" ValueChanged="v => Settings.Update(s => s with { DefaultView = v })" />
    </section>
</div>

@code {
    [Inject] private SettingsStore Settings { get; set; } = default!;
    [Inject] private Workspace Workspace { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    /// <summary>Native folder dialog, registered by the desktop host (absent in tests).</summary>
    [Inject] private IServiceProvider Services { get; set; } = default!;
    private FolderPicker? Picker => Services.GetService(typeof(FolderPicker)) as FolderPicker;

    private static readonly IReadOnlyList<(string, string)> Themes = [("light", "Light"), ("dark", "Dark"), ("system", "System")];
    private static readonly IReadOnlyList<(string, string)> Views = [("board", "Board"), ("list", "List")];

    private string repoPath = "";
    private string? error;

    protected override void OnInitialized() => repoPath = Workspace.Root ?? Settings.Current.LastRepo ?? "";

    private void Browse()
    {
        if (Picker?.Invoke() is string chosen) { repoPath = chosen; Open(); }
    }

    private void Open()
    {
        (bool ok, string message) = Workspace.Open(repoPath);
        error = ok ? null : message;
        if (ok) Nav.NavigateTo("");
    }
}
