@page "/settings"
@using Notes

<div class="sheet settings" data-sk="soft">
    <h2>Settings</h2>

    <section class="set-row">
        <div><h3>Theme</h3><p class="muted">System follows your OS setting.</p></div>
        <Seg Name="theme" Options="Themes" Value="@Settings.Current.Theme" ValueChanged="v => Settings.Update(s => s with { Theme = v })" />
    </section>

    <section class="set-row">
        <div><h3>Open another repository</h3><p class="muted">Folder with the openspec/ directory this app reads and writes. A folder without one is set up for OpenSpec when opened. It joins the projects below.</p></div>
        <div class="set-val">
            <input id="f-repo" class="box text-in" data-sk value="@repoPath" placeholder="Path to a repository…" @onchange="e => repoPath = (string?)e.Value ?? string.Empty" aria-label="Repository folder" />
            @if (Picker is not null) { <button class="btn" data-sk @onclick="Browse">Browse…</button> }
            <button class="btn primary open-repo" data-sk @onclick="Open">Open</button>
        </div>
    </section>
    @if (error is not null) { <p class="warning">@error</p> }

    <section class="set-row">
        <div><h3>Your name</h3><p class="muted">Used for new work items and notes. Empty = git user.name.</p></div>
        <div class="set-val"><input class="box text-in" data-sk value="@Settings.Current.Name" placeholder="@Workspace.Me"
                                    @onchange="e => Settings.Update(s => s with { Name = string.IsNullOrWhiteSpace((string?)e.Value) ? null : ((string)e.Value!).Trim() })" aria-label="Your name" /></div>
    </section>

    <section class="set-row">
        <div><h3>Default board view</h3><p class="muted">What the board shows when you open a repository for the first time.</p></div>
        <Seg Name="defview" Options="Views" Value="@Settings.Current.DefaultView" ValueChanged="v => Settings.Update(s => s with { DefaultView = v })" />
    </section>

    <section class="set-row">
        <div><h3>Keyboard hints</h3><p class="muted">Press F to show a letter on every clickable element, then type it. Shift + the letter selects. Off by default.</p></div>
        <label class="check"><input type="checkbox" id="f-hints" checked="@Settings.Current.Hints" @onchange="e => Settings.Update(s => s with { Hints = (bool)e.Value! })" /> on</label>
    </section>

    @foreach (string repo in Workspace.OpenRepos)
    {
        string project = System.IO.Path.GetFileName(repo.TrimEnd('\\', '/'));
        <section class="set-row" data-project="@project">
            <div><h3>@project</h3><p class="muted">Folders are relative to the repository; agents read them from openspec/REPO-TASKS.md. Plans: yours only, empty = @SettingsStore.DefaultPlansDir. Attachments: saved with the project, so every computer on it uses the same folder, empty = @SettingsStore.DefaultAttachmentsDir (kept out of git).</p></div>
            <div class="set-val set-folders">
                <span class="muted">Location</span>
                <div class="set-loc">
                    <span class="set-path" title="@repo">@repo</span>
                    <button class="btn show-folder" data-sk @onclick="() => ShowInFolder(repo)">Show in folder</button>
                </div>
                <span class="muted">Plans</span>
                <input class="box text-in" data-sk value="@Settings.PlansDir(repo)" placeholder="@SettingsStore.DefaultPlansDir"
                       @onchange="e => Settings.SetPlansDir(repo, (string?)e.Value)" aria-label="Plans folder" />
                <span class="muted">Attachments</span>
                <input class="box text-in" data-sk @key="attKey" value="@(attAsk is { } pending && pending.Repo == repo ? pending.New : Settings.AttachmentsDir(repo))" placeholder="@SettingsStore.DefaultAttachmentsDir"
                       @onchange="e => AttachmentsChanged(repo, (string?)e.Value)" aria-label="Attachments folder" />
                @if (attAsk is { } ask && ask.Repo == repo)
                {
                    <div class="att-row att-ask">
                        <p>Move the @ask.Files file@(ask.Files == 1 ? "" : "s") in <code>@ask.Old</code> to <code>@ask.New</code>? Notes and descriptions will point to the new place.</p>
                        <div class="att-actions">
                            <button class="btn primary att-move" data-sk @onclick="AttachmentsMove">Move</button>
                            <button class="btn att-keep" data-sk @onclick="AttachmentsKeep">Keep them where they are</button>
                            <button class="btn att-cancel" data-sk @onclick="AttachmentsCancel">Cancel</button>
                        </div>
                    </div>
                }
                @if (attNote is { } note && note.Repo == repo) { <p class="att-row @(note.Warn ? "att-warn" : "att-done muted")">@note.Text</p> }
            </div>
        </section>
        <BoardStorageSection Root="@repo" />
    }

    <section class="set-row mcp">
        <div>
            <h3>Agents over MCP</h3>
            <p class="muted">Add this to <code>.mcp.json</code> in a repository so agents can read and write its board with tools instead of editing files. The path is this app's exe on this machine.</p>
            @if (Server is not null && server is not null)
            {
                <p class="mcp-status">
                    <span class="chip @(server.Running ? "on" : null)">@(busy ? "Working…" : server.Running ? $"Server running · port {server.Port}" : "Server not running")</span>
                    <button class="btn" data-sk disabled="@busy" @onclick="ToggleServer">@(server.Running ? "Stop" : "Start")</button>
                </p>
                @if (!server.Running) { <p class="muted">It starts by itself when an agent connects, and stops after three idle hours.</p> }
            }
        </div>
        <div class="set-val">
            <pre class="box mcp-snippet" data-sk>@AgentGuide.McpSnippet()</pre>
            <p class="muted">One line instead: <code>@AgentGuide.McpAddCommand()</code></p>
        </div>
    </section>

    <section class="set-row">
        <div><h3>External editor</h3><p class="muted">Command "Edit in …" launches on a note, e.g. code, notepad++, subl. Empty = ask next time.</p></div>
        <div class="set-val"><input class="box text-in" data-sk value="@Settings.Current.Editor" placeholder="e.g. code"
                                    @onchange="e => Settings.Update(s => s with { Editor = string.IsNullOrWhiteSpace((string?)e.Value) ? null : ((string)e.Value!).Trim() })" aria-label="External editor" /></div>
    </section>
</div>

@code {
    [Inject] private SettingsStore Settings { get; set; } = default!;
    [Inject] private Workspace Workspace { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private UiService Popups { get; set; } = default!;
    /// <summary>Native folder dialog, registered by the desktop host (absent in tests).</summary>
    [Inject] private IServiceProvider Services { get; set; } = default!;
    private FolderPicker? Picker => Services.GetService(typeof(FolderPicker)) as FolderPicker;

    /// <summary>The headless MCP server's status and switch, registered by the desktop host (absent in tests).</summary>
    private TaskManager.Hosting.McpServerControl? Server => Services.GetService(typeof(TaskManager.Hosting.McpServerControl)) as TaskManager.Hosting.McpServerControl;
    private TaskManager.Hosting.McpServerState? server;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        if (Server is not null) server = await Server.Status();
    }

    private async Task ToggleServer()
    {
        if (Server is null || server is null) return;
        bool starting = !server.Running;
        busy = true;
        try
        {
            await (starting ? Server.Start() : Server.Stop());
            server = await Server.Status();
            if (starting && !server.Running) Popups.Toast("The MCP server did not start; see the log under %LOCALAPPDATA%/RepoTaskManager/logs.", ToastKind.Warning);
        }
        finally { busy = false; }
    }

    private static readonly IReadOnlyList<(string, string)> Themes = [("light", "Light"), ("dark", "Dark"), ("system", "System")];
    private static readonly IReadOnlyList<(string, string)> Views = [("board", "Board"), ("list", "List")];

    // ── the attachments folder: changing it asks what to do with the files already in it ──

    private sealed record AttachmentsAsk(string Repo, string Old, string New, int Files);
    private sealed record AttachmentsNote(string Repo, string Text, bool Warn);
    private AttachmentsAsk? attAsk;
    private AttachmentsNote? attNote;
    private int attKey;   // a new key makes the browser drop what was typed in the field (a refused or cancelled edit shows the saved folder again)

    private void AttachmentsChanged(string repo, string? typed)
    {
        (attAsk, attNote) = (null, null);
        (bool ok, string dir, string why) = NotesApi.CheckAttachmentsDir(typed);
        string old = Settings.AttachmentsDir(repo);
        if (!ok) { attNote = new(repo, why, true); attKey++; return; }
        if (dir == old) { attKey++; return; }
        int files = Workspace.In(repo, () => NotesApi.CountAttachmentFiles(repo, old));
        if (files > 0) { attAsk = new(repo, old, dir, files); return; }   // saved once the user has answered
        SaveAttachmentsDir(repo, dir);
    }

    private bool SaveAttachmentsDir(string repo, string dir, bool moved = false)
    {
        Workspace.AttachmentsFolderChangingHere(repo, dir, moved);   // before the write: the sync service must not take this change for a pull's and move the files a second time
        (bool ok, string message) = Settings.SetAttachmentsDir(repo, dir);
        if (!ok) { attNote = new(repo, message, true); attKey++; Workspace.AttachmentsFolderChangingHere(repo, Settings.AttachmentsDir(repo), false); }
        return ok;
    }

    private void AttachmentsMove()
    {
        if (attAsk is not { } ask) return;
        attAsk = null;
        Notes.PublicDTOs.AttachmentsMoveResult result = Workspace.In(ask.Repo, () => NotesApi.MoveAttachments(ask.Repo, ask.Old, ask.New));
        if (!result.Success) { attNote = new(ask.Repo, result.Message, true); attKey++; return; }
        if (SaveAttachmentsDir(ask.Repo, ask.New, moved: true)) attNote = new(ask.Repo, result.Message, false);
        Workspace.Notify();   // notes and descriptions were rewritten: every open page reads them again
    }

    private void AttachmentsKeep()
    {
        if (attAsk is not { } ask) return;
        attAsk = null;
        SaveAttachmentsDir(ask.Repo, ask.New);   // new files go to the new folder; the old ones and their references stay
    }

    private void AttachmentsCancel() { attAsk = null; attKey++; }

    private string repoPath = "";
    private string? error;

    private FolderOpener? FolderOpener => Services.GetService(typeof(FolderOpener)) as FolderOpener;

    private void ShowInFolder(string repo)
    {
        if (FolderOpener?.Invoke(repo) is { Success: false, Message: string message }) Popups.Toast(message, ToastKind.Warning);
    }

    private void Browse()
    {
        if (Picker?.Invoke() is string chosen) { repoPath = chosen; Open(); }
    }

    private void Open()
    {
        (bool ok, string message) = Workspace.OpenTab(repoPath);
        error = ok ? null : message;
        if (ok && Workspace.TakeGuideNotice() is string notice) Popups.Toast(notice, ToastKind.Info);
        if (ok) Nav.NavigateTo("");
    }
}
