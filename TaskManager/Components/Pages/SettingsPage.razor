@page "/settings"
@using Notes

<div class="sheet settings" data-sk="soft">
    <h2>Settings</h2>

    <section class="set-row">
        <div><h3>Theme</h3><p class="muted">System follows your OS setting.</p></div>
        <Seg Name="theme" Options="Themes" Value="@Settings.Current.Theme" ValueChanged="v => Settings.Update(s => s with { Theme = v })" />
    </section>

    <section class="set-row" data-setting="user-settings">
        <div>
            <h3>User settings</h3>
            <p class="muted">What you arrange for each project (the view, grouping, sort, hidden columns, rows and projects, the list's column order and widths) and the settings on this page are kept in one file on this computer, never in a repository and never synced. Move it to a folder of your choice; it keeps its name, settings.json.</p>
        </div>
        <div class="set-val">
            <div class="set-loc">
                <span class="set-path" title="@Settings.FilePath">@System.IO.Path.GetDirectoryName(Settings.FilePath)</span>
            </div>
            <input class="box text-in" data-sk value="@settingsFolder" placeholder="Folder to move the settings to…" @onchange="e => settingsFolder = (string?)e.Value ?? string.Empty" aria-label="User settings folder" />
            @if (Picker is not null) { <button class="btn pick-settings-folder" data-sk @onclick="BrowseSettings">Browse…</button> }
            <button class="btn primary move-settings" data-sk disabled="@(settingsFolder.Trim().Length == 0)" @onclick="MoveSettings">Move</button>
            @if (Settings.Notice is { } notice) { <p class="warning settings-notice">@notice</p> }
            @if (settingsMoved is { } moved) { <p class="@(movedOk ? "muted settings-moved" : "warning settings-moved")">@moved</p> }
        </div>
    </section>

    <section class="set-row">
        <div><h3>Open another repository</h3><p class="muted">Folder with the openspec/ directory this app reads and writes. A folder without one is set up for OpenSpec when opened. It joins the projects below.</p></div>
        <div class="set-val">
            <input id="f-repo" class="box text-in" data-sk value="@repoPath" placeholder="Path to a repository…" @onchange="e => repoPath = (string?)e.Value ?? string.Empty" aria-label="Repository folder" />
            @if (Picker is not null) { <button class="btn" data-sk @onclick="Browse">Browse…</button> }
            <button class="btn primary open-repo" data-sk @onclick="Open">Open</button>
        </div>
    </section>
    @if (error is not null) { <p class="warning">@error</p> }

    <section class="set-row">
        <div><h3>Your name</h3><p class="muted">Used for new work items and notes. Empty = git user.name.</p></div>
        <div class="set-val"><input class="box text-in" data-sk value="@Settings.Current.Name" placeholder="@Workspace.Me"
                                    @onchange="e => Settings.Update(s => s with { Name = string.IsNullOrWhiteSpace((string?)e.Value) ? null : ((string)e.Value!).Trim() })" aria-label="Your name" /></div>
    </section>

    <section class="set-row">
        <div><h3>Keyboard hints</h3><p class="muted">Press F to show a letter on every clickable element, then type it. Shift + the letter selects. Off by default.</p></div>
        <label class="check"><input type="checkbox" id="f-hints" checked="@Settings.Current.Hints" @onchange="e => Settings.Update(s => s with { Hints = (bool)e.Value! })" /> on</label>
    </section>

    @foreach (string repo in Workspace.OpenRepos)
    {
        string project = System.IO.Path.GetFileName(repo.TrimEnd('\\', '/'));
        <section class="set-row" data-project="@project">
            <div><h3>@project</h3><p class="muted">One folder for this project's files, relative to the repository and saved with the project. Images are kept out of git and synced with the board storage; plans stay in git.</p></div>
            <div class="set-val set-folders">
                <span class="muted">Location</span>
                <div class="set-loc">
                    <span class="set-path" title="@repo">@repo</span>
                    <button class="btn show-folder" data-sk @onclick="() => ShowInFolder(repo)">Show in folder</button>
                </div>
                <span class="muted">Files</span>
                <input class="box text-in" data-sk @key="filesKey" value="@(filesAsk is { } pending && pending.Repo == repo ? pending.New : Settings.FilesDir(repo) ?? "")" placeholder="@SettingsStore.DefaultFilesDir"
                       @onchange="e => FilesChanged(repo, (string?)e.Value)" aria-label="Files folder" />
                <p class="att-row muted files-now">Images: @Settings.AttachmentsDir(repo) · Plans: @Settings.PlansDir(repo)</p>
                @if (Settings.FilesDir(repo) is null && !(filesAsk is { } waiting && waiting.Repo == repo))
                {
                    <p class="att-row muted files-legacy">Plans are in <code>@Settings.PlansDir(repo)</code> and images in <code>@Settings.AttachmentsDir(repo)</code>. <button class="files-put-both" data-sk @onclick="() => FilesChanged(repo, SettingsStore.DefaultFilesDir)">Put both in one folder</button></p>
                }
                @if (filesAsk is { } ask && ask.Repo == repo)
                {
                    <div class="att-row att-ask">
                        <p>Move @ask.What? Notes, descriptions and plan links will point to the new places.</p>
                        <div class="att-actions">
                            <button class="btn primary att-move" data-sk @onclick="FilesMove">Move</button>
                            <button class="btn att-keep" data-sk @onclick="FilesKeep">Keep them where they are</button>
                            <button class="btn att-cancel" data-sk @onclick="FilesCancel">Cancel</button>
                        </div>
                    </div>
                }
                @if (filesNote is { } note && note.Repo == repo) { <p class="att-row @(note.Warn ? "att-warn" : "att-done muted")">@note.Text</p> }
            </div>
        </section>
        <BoardStorageSection Root="@repo" />
    }

    <section class="set-row mcp">
        <div>
            <h3>Agents over MCP</h3>
            <p class="muted">Add this to <code>.mcp.json</code> in a repository so agents can read and write its board with tools instead of editing files. The path is this app's exe on this machine.</p>
            @if (Server is not null && server is not null)
            {
                <p class="mcp-status">
                    <span class="chip @(server.Running ? "on" : null)">@(busy ? "Working…" : server.Running ? $"Server running · port {server.Port}" : "Server not running")</span>
                    <button class="btn" data-sk disabled="@busy" @onclick="ToggleServer">@(server.Running ? "Stop" : "Start")</button>
                </p>
                @if (!server.Running) { <p class="muted">It starts by itself when an agent connects, and stops after three idle hours.</p> }
            }
        </div>
        <div class="set-val">
            <pre class="box mcp-snippet" data-sk>@AgentGuide.McpSnippet()</pre>
            <p class="muted">One line instead: <code>@AgentGuide.McpAddCommand()</code></p>
        </div>
    </section>

    <section class="set-row">
        <div><h3>External editor</h3><p class="muted">Command "Edit in …" launches on a note, e.g. code, notepad++, subl. Empty = ask next time.</p></div>
        <div class="set-val"><input class="box text-in" data-sk value="@Settings.Current.Editor" placeholder="e.g. code"
                                    @onchange="e => Settings.Update(s => s with { Editor = string.IsNullOrWhiteSpace((string?)e.Value) ? null : ((string)e.Value!).Trim() })" aria-label="External editor" /></div>
    </section>
</div>

@code {
    [Inject] private SettingsStore Settings { get; set; } = default!;
    [Inject] private Workspace Workspace { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private UiService Popups { get; set; } = default!;
    /// <summary>Native folder dialog, registered by the desktop host (absent in tests).</summary>
    [Inject] private IServiceProvider Services { get; set; } = default!;
    private FolderPicker? Picker => Services.GetService(typeof(FolderPicker)) as FolderPicker;

    /// <summary>The headless MCP server's status and switch, registered by the desktop host (absent in tests).</summary>
    private TaskManager.Hosting.McpServerControl? Server => Services.GetService(typeof(TaskManager.Hosting.McpServerControl)) as TaskManager.Hosting.McpServerControl;
    private TaskManager.Hosting.McpServerState? server;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        if (Server is not null) server = await Server.Status();
    }

    private async Task ToggleServer()
    {
        if (Server is null || server is null) return;
        bool starting = !server.Running;
        busy = true;
        try
        {
            await (starting ? Server.Start() : Server.Stop());
            server = await Server.Status();
            if (starting && !server.Running) Popups.Toast("The MCP server did not start; see the log under %LOCALAPPDATA%/RepoTaskManager/logs.", ToastKind.Warning);
        }
        finally { busy = false; }
    }

    private static readonly IReadOnlyList<(string, string)> Themes = [("light", "Light"), ("dark", "Dark"), ("system", "System")];

    // ── the files folder: changing it asks what to do with the images and plans already in the old places ──

    private sealed record FilesAsk(string Repo, string New, string OldImages, string OldPlans, int Images, int Plans, int PlanFiles)
    {
        public string NewImages => New + "/" + SettingsStore.ImagesName;
        public string NewPlans => New + "/" + SettingsStore.PlansName;
        public string What => string.Join(" and ", new[]
        {
            Images > 0 ? $"{Images} image{(Images == 1 ? "" : "s")} from {OldImages} to {NewImages}" : null,
            PlanFiles > 0 ? $"{(Plans > 0 ? $"{Plans} plan{(Plans == 1 ? "" : "s")}" : $"{PlanFiles} file{(PlanFiles == 1 ? "" : "s")}")} from {OldPlans} to {NewPlans}" : null,
        }.OfType<string>());
    }

    private sealed record FilesNote(string Repo, string Text, bool Warn);
    private FilesAsk? filesAsk;
    private FilesNote? filesNote;
    private int filesKey;   // a new key makes the browser drop what was typed in the field (a refused or cancelled edit shows the saved folder again)

    private void FilesChanged(string repo, string? typed)
    {
        (filesAsk, filesNote) = (null, null);
        string? current = Settings.FilesDir(repo);
        if (current is null && string.IsNullOrWhiteSpace(typed)) { filesKey++; return; }   // nothing chosen: the old layout stays
        (bool ok, string dir, string why) = NotesApi.CheckFilesDir(typed);
        if (!ok) { filesNote = new(repo, why, true); filesKey++; return; }
        if (dir == current) { filesKey++; return; }
        string oldImages = Settings.AttachmentsDir(repo), oldPlans = Settings.PlansDir(repo);
        string newImages = dir + "/" + SettingsStore.ImagesName, newPlans = dir + "/" + SettingsStore.PlansName;
        int images = oldImages == newImages ? 0 : Workspace.In(repo, () => NotesApi.CountAttachmentFiles(repo, oldImages));
        (int plans, int planFiles) = oldPlans == newPlans ? (0, 0) : Workspace.In(repo, () => NotesApi.CountPlanFiles(repo, oldPlans));
        if (images + planFiles > 0) { filesAsk = new(repo, dir, oldImages, oldPlans, images, plans, planFiles); return; }   // saved once the user has answered
        SaveFilesDir(repo, dir);
    }

    private bool SaveFilesDir(string repo, string dir, bool imagesMoved = false)
    {
        Workspace.AttachmentsFolderChangingHere(repo, dir + "/" + SettingsStore.ImagesName, imagesMoved);   // before the write: the sync service must not take this change for a pull's and move the files a second time
        (bool ok, string message) = Settings.SetFilesDir(repo, dir);
        if (!ok) { filesNote = new(repo, message, true); filesKey++; Workspace.AttachmentsFolderChangingHere(repo, Settings.AttachmentsDir(repo), false); }
        return ok;
    }

    private void FilesMove()
    {
        if (filesAsk is not { } ask) return;
        filesAsk = null;
        List<string> said = [];
        bool imagesMoved = false, plansFailed = false;
        if (ask.Images > 0)
        {
            Notes.PublicDTOs.AttachmentsMoveResult images = Workspace.In(ask.Repo, () => NotesApi.MoveAttachments(ask.Repo, ask.OldImages, ask.NewImages));
            if (!images.Success) { filesNote = new(ask.Repo, images.Message, true); filesKey++; return; }   // nothing was moved: the old places stay in use
            imagesMoved = images.Moved + images.Duplicates > 0;
            said.Add(images.Message);
        }
        if (ask.PlanFiles > 0)
        {
            Notes.PublicDTOs.AttachmentsMoveResult plans = Workspace.In(ask.Repo, () => NotesApi.MovePlans(ask.Repo, ask.OldPlans, ask.NewPlans));
            plansFailed = !plans.Success;
            said.Add(plans.Success ? plans.Message : $"The plans were not moved: {plans.Message}");
        }
        if (SaveFilesDir(ask.Repo, ask.New, imagesMoved)) filesNote = new(ask.Repo, string.Join(" ", said), plansFailed);
        Workspace.Notify();   // notes, descriptions and plan links were rewritten: every open page reads them again
    }

    private void FilesKeep()
    {
        if (filesAsk is not { } ask) return;
        filesAsk = null;
        SaveFilesDir(ask.Repo, ask.New);   // new files go to the new folder; the old ones and their links stay
    }

    private void FilesCancel() { filesAsk = null; filesKey++; }

    private string repoPath = "";
    private string? error;

    private string settingsFolder = "";
    private string? settingsMoved;
    private bool movedOk;

    private void BrowseSettings()
    {
        if (Picker?.Invoke("Choose a folder for your user settings") is string chosen) settingsFolder = chosen;
    }

    private void MoveSettings()
    {
        (movedOk, settingsMoved) = Settings.MoveTo(settingsFolder);
        if (movedOk) settingsFolder = "";
    }

    private FolderOpener? FolderOpener => Services.GetService(typeof(FolderOpener)) as FolderOpener;

    private void ShowInFolder(string repo)
    {
        if (FolderOpener?.Invoke(repo) is { Success: false, Message: string message }) Popups.Toast(message, ToastKind.Warning);
    }

    private void Browse()
    {
        if (Picker?.Invoke() is string chosen) { repoPath = chosen; Open(); }
    }

    private void Open()
    {
        (bool ok, string message) = Workspace.OpenTab(repoPath);
        error = ok ? null : message;
        if (ok && Workspace.TakeGuideNotice() is string notice) Popups.Toast(notice, ToastKind.Info);
        if (ok) Nav.NavigateTo("");
    }
}
