@page "/note/{Id:int}"
@using System.Text.RegularExpressions
@using GitHistory
@using GitHistory.PublicDTOs
@using Notes
@using Notes.PublicDTOs
@inherits RepoPage

@if (note is null)
{
    <NotFound What="@($"#n{Id}")" />
    return;
}

<div class="sheet" data-sk="soft">
    <div class="head kvs">
        <div class="kv"><label>note</label><h2 class="num">#n@(note.Id)</h2></div>
        @* the title is the frontmatter title: of the note (older notes: their first "# " heading); the body is not touched (@key re-renders the old text back when a blank is refused) *@
        <div class="kv title-kv"><label>title</label><input @key="titleKey" class="note-title hov" data-sk value="@note.Title" aria-label="Note title" @onchange="SetTitle" /></div>
        <div class="kv"><label>linked to</label><a class="wl" href="item/@note.WorkItemId">#wi@(note.WorkItemId)</a></div>
        <div class="kv"><label>created</label><span class="num">@note.Created.ToString("yyyy-MM-dd HH:mm")</span></div>
        <div class="kv"><label>last modified</label><span class="num">@modified.ToString("yyyy-MM-dd HH:mm")</span>@if (saving) { <span class="muted"> · saving…</span> }</div>
        <div class="kv"><label>by</label><span>@note.By</span></div>
        @if (note.AgentUnreviewed) { <div class="kv"><AgentChip By="@note.AgentBy" At="note.AgentAt" OnReview="() => Run(NotesApi.MarkReviewed(note.Id))" /></div> }
        <BackButton />
    </div>
    @* the same tiles as the work item page. The note is edited like a work item's description: the rendered markdown, and on
       a click a plain text box (autosaved shortly after typing stops; leaving it saves at once and renders again). *@
    <div class="note-grid">
        <section class="tile" data-tile="note">
            <div class="tile-h"><h3>Note</h3></div>
            @if (editing)
            {
                <textarea @ref="editorBox" class="desc-in" value="@body" @oninput="OnInput" @onblur="Done" aria-label="Note"></textarea>
            }
            else
            {
                <div class="desc edit hov note-view" data-sk tabindex="0" @onclick="Edit" @onkeydown="OpenKey">
                    @if (string.IsNullOrWhiteSpace(previewBody)) { <span class="muted">Click to add text</span> }
                    else { @Preview }
                </div>
            }
            <button class="add edit-ext" @onclick="EditExternally">@(Settings.Current.Editor is string e ? $"Edit in {e}" : "Edit in…")</button>
        </section>
        <section class="tile" data-tile="links">
            <div class="tile-h"><h3>Linked docs and commits</h3></div>
            <div class="links">
                @foreach (NoteLink l in links)
                {
                    <div class="link @(l.Resolved ? "hov" : "bad")" data-sk="@(l.Resolved ? "" : null)">
                        <span class="k">@l.Kind</span>
                        @if (l.Resolved && l.Kind != "doc") { <a class="wl" href="@(l.Kind == "item" ? "item" : "note")/@l.Target">@Label(l)</a> }
                        else { <span>@Label(l)</span> }
                        @if (!l.Resolved) { <span class="muted"> unresolved</span> }
                    </div>
                }
                @foreach (CommitInfo c in commits)
                {
                    bool picked = note.Commits.Contains(c.Hash);
                    <div class="link hov" data-sk><span class="k">commit</span><span><span class="mono">@c.Hash</span> @c.Subject</span>
                        @if (picked) { <button class="ic" aria-label="Unlink commit" title="Unlink" @onclick="() => UnlinkCommit(c.Hash)">×</button> }</div>
                }
                @foreach (string m in note.ManualLinks) { <div class="link"><span class="k">link</span><span>@m</span></div> }
            </div>
            @if (GitHistoryApi.IsRepository())
            {
                <PickerMenu TItem="CommitInfo" Label="Link a commit" ButtonText="+ link commit" Placeholder="Filter commits…"
                            Items="GitHistoryApi.Recent(50).Where(c => commits.All(x => x.Hash != c.Hash))" Text="c => [c.Hash, c.Subject, c.Author]" OnPick="c => LinkCommit(c.Hash)">
                    <ItemTemplate Context="c"><span class="mono">@c.Hash</span> @c.Subject <span class="muted">· @c.Author</span></ItemTemplate>
                </PickerMenu>
            }
            <form class="add-line" @onsubmit="AddLink" @onsubmit:preventDefault="true">
                <input @bind="newLink" placeholder="Add a link by hand…" aria-label="New link" /><button class="btn" data-sk type="submit">add</button>
            </form>
            <span class="muted">The list fills in as you type valid [[doc]], #wi and #n references.</span>
        </section>
        <section class="tile attachments" data-tile="attachments">
            <div class="tile-h"><h3>Attachments</h3><span class="muted">kept out of git, under local/</span></div>
            <div class="att-list">
                @foreach (string a in note.Attachments)
                {
                    <div class="att">
                        @if (IsUrl(a)) { <a class="att-link" href="@a" target="_blank">@a</a> }
                        else if (IsImage(a) && ImageSrc(a) is string src) { <img class="att-img" src="@src" alt="@System.IO.Path.GetFileName(a)" /> }
                        else if (IsImage(a)) { <span class="muted">@System.IO.Path.GetFileName(a)</span> }
                        else { <button class="att-file" data-sk @onclick="() => OpenFile(a)">@System.IO.Path.GetFileName(a)</button> }
                        <button class="ic att-x" aria-label="Remove attachment" title="Remove" @onclick="() => Run(NotesApi.RemoveAttachment(Id, a))">×</button>
                    </div>
                }
            </div>
            @if (Services.GetService(typeof(FilePicker)) is FilePicker pick)
            {
                <button class="add att-add" @onclick="() => AttachFile(pick)">Attach file…</button>
            }
            <form class="add-line" @onsubmit="AddAttachedLink" @onsubmit:preventDefault="true">
                <input class="att-url" @bind="attachUrl" @bind:event="oninput" placeholder="Attach a link…" aria-label="Attach link" /><button class="btn" data-sk type="submit">Add link</button>
            </form>
        </section>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Inject] private SettingsStore Settings { get; set; } = default!;
    [Inject] private IServiceProvider Services { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;
    private EditorLauncher? Launcher => Services.GetService(typeof(EditorLauncher)) as EditorLauncher;

    private Note? note;
    private string body = "";          // the text, as typed (the editor binds to it; autosave writes it)
    private string previewBody = "";   // what preview/links show; refreshed after a short pause in typing
    private bool editing;
    private int titleKey;
    private ElementReference editorBox;
    private DotNetObjectReference<NotePage>? self;
    private bool focusEditor;
    private CancellationTokenSource? pendingPreview;
    private DateTime modified;
    private IReadOnlyList<NoteLink> links = [];
    private IReadOnlyList<CommitInfo> commits = [];
    private string newLink = "";
    private bool saving;
    private CancellationTokenSource? pendingSave;

    // Outside edits reload the note, but never while there is typing not yet on disk (that would wipe it).
    protected override void OnChanged() { if (!saving) base.OnChanged(); }

    protected override void Load()
    {
        note = NotesApi.Get(Id);
        if (note is null) return;
        body = previewBody = note.Body;
        modified = note.Modified;
        links = NotesApi.ResolveLinks(body);
        commits = [.. GitHistoryApi.Mentioning($"#wi{note.WorkItemId}").Concat(GitHistoryApi.Commits(note.Commits)).DistinctBy(c => c.Hash)];
    }

    private void OnInput(ChangeEventArgs e)
    {
        body = e.Value?.ToString() ?? "";
        // ponytail: link resolution reads the repo, so do it on a 250 ms pause rather than per keystroke
        pendingPreview?.Cancel();
        CancellationTokenSource preview = pendingPreview = new();
        _ = Task.Delay(250, preview.Token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            InvokeAsync(() => { previewBody = body; links = NotesApi.ResolveLinks(previewBody); StateHasChanged(); });
        }, TaskScheduler.Default);
        saving = true;
        pendingSave?.Cancel();
        CancellationTokenSource cts = pendingSave = new();
        _ = Task.Delay(600, cts.Token).ContinueWith(t => { if (!t.IsCanceled) InvokeAsync(Save); }, TaskScheduler.Default);
    }

    /// <summary>
    /// Autosave writes the file and nothing else: it must not trigger a reload, because the reload would put the
    /// saved text back into the editor and drop whatever was typed since. Other pages re-read on navigation.
    /// </summary>
    private void Save()
    {
        string saved = body;
        (bool ok, string message) = NotesApi.SaveBody(Id, saved);
        if (!ok) { saving = false; Popups.Toast(message, ToastKind.Warning); return; }
        modified = DateTime.Now;
        saving = body != saved;   // more typing arrived while saving: its own save is already scheduled
        if (!saving) Popups.Saved();
        StateHasChanged();
    }

    /// <summary>Leaving the editor: save now (the autosave may still be pending) and read the note again.</summary>
    private void Done()
    {
        if (!editing) return;
        pendingSave?.Cancel();
        pendingPreview?.Cancel();
        editing = false;
        previewBody = body;
        links = NotesApi.ResolveLinks(previewBody);
        Save();
    }

    private void Edit() => editing = focusEditor = true;

    private void OpenKey(KeyboardEventArgs e) { if (e.Key is "Enter" or " ") Edit(); }

    /// <summary>Called by rtm.pasteImages with a clipboard image: it becomes an attachment, like a picked file.</summary>
    [JSInvokable]
    public void PastedImage(string name, string base64)
    {
        try { Run(NotesApi.AttachBytes(Id, name, Convert.FromBase64String(base64))); }
        catch (FormatException) { Popups.Toast("That image could not be read", ToastKind.Warning); }
    }

    private void SetTitle(ChangeEventArgs e)
    {
        if (editing || saving) { pendingSave?.Cancel(); Save(); }   // what is typed goes to disk first: the title rewrites the same file
        if (!Run(NotesApi.SetTitle(Id, e.Value?.ToString() ?? ""))) titleKey++;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (note is null) return;
        if (self is null)
        {
            self = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("rtm.pasteImages", self);
        }
        if (!focusEditor) return;
        focusEditor = false;
        try { await editorBox.FocusAsync(); } catch (InvalidOperationException) { }
    }

    private void AddLink()
    {
        Run(NotesApi.AddManualLink(Id, newLink));
        newLink = "";
    }

    private string attachUrl = "";

    private static bool IsUrl(string a) => a.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || a.StartsWith("https://", StringComparison.OrdinalIgnoreCase);

    private static readonly Dictionary<string, string> ImageTypes = new(StringComparer.OrdinalIgnoreCase)
    { [".png"] = "image/png", [".jpg"] = "image/jpeg", [".jpeg"] = "image/jpeg", [".gif"] = "image/gif", [".webp"] = "image/webp", [".svg"] = "image/svg+xml" };

    private static bool IsImage(string a) => ImageTypes.ContainsKey(System.IO.Path.GetExtension(a));

    private string? FullPath(string entry) =>
        Workspace.Root is string root && !entry.Contains("..") ? System.IO.Path.Combine(root, entry.Replace('/', System.IO.Path.DirectorySeparatorChar)) : null;

    /// <summary>The image as a data URL, or null when its file is missing.</summary>
    private string? ImageSrc(string entry) =>
        FullPath(entry) is string p && System.IO.File.Exists(p) ? $"data:{ImageTypes[System.IO.Path.GetExtension(entry)]};base64,{Convert.ToBase64String(System.IO.File.ReadAllBytes(p))}" : null;

    private void OpenFile(string entry)
    {
        if (FullPath(entry) is not string p || !System.IO.File.Exists(p)) { Popups.Toast("That file is no longer there", ToastKind.Warning); return; }
        try { System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(p) { UseShellExecute = true }); }
        catch (Exception e) when (e is System.ComponentModel.Win32Exception or InvalidOperationException) { Popups.Toast(e.Message, ToastKind.Warning); }
    }

    private void AttachFile(FilePicker pick)
    {
        if (pick("Attach a file") is string chosen) Run(NotesApi.AttachFile(Id, chosen));
    }

    private void AddAttachedLink()
    {
        if (Run(NotesApi.AttachLink(Id, attachUrl))) attachUrl = "";
    }

    private static string Label(NoteLink l) => l.Kind switch { "item" => $"#wi{l.Target}", "note" => $"#n{l.Target}", _ => l.Target };

    private void LinkCommit(string hash) => Run(NotesApi.SetLinkedCommits(Id, [.. note!.Commits, hash]));

    private void UnlinkCommit(string hash) => Run(NotesApi.SetLinkedCommits(Id, note!.Commits.Where(h => h != hash)));

    private async Task EditExternally()
    {
        if (note is null) return;
        string? editor = Settings.Current.Editor;
        if (string.IsNullOrWhiteSpace(editor))
        {
            string? typed = await Popups.Prompt("Which editor should open files?", "e.g. code, notepad++, subl, or a full path", "Use it");
            if (string.IsNullOrWhiteSpace(typed)) return;
            editor = typed.Trim();
            Settings.Update(s => s with { Editor = editor });
        }
        if (Launcher is null) return;
        (bool ok, string message) = Launcher(editor, note.Path);
        if (!ok) Popups.Toast(message, ToastKind.Warning);
    }

    /// <summary>Markdig HTML with [[doc]], #wiN and #nN turned into links (unresolved ones struck through).</summary>
    private MarkupString Preview
    {
        get
        {
            HashSet<string> ok = links.Where(l => l.Resolved).Select(l => $"{l.Kind}:{l.Target}").ToHashSet();
            string html = Markdig.Markdown.ToHtml(previewBody, Ui.Pipeline);
            html = Regex.Replace(html, @"\[\[([^\]<]+)\]\]", m => $"<span class=\"wl{(ok.Contains("doc:" + m.Groups[1].Value.Trim()) ? "" : " bad")}\">{m.Groups[1].Value}</span>");
            html = Regex.Replace(html, @"#wi(\d+)\b", m => ok.Contains("item:" + m.Groups[1].Value) ? $"<a class=\"wl\" href=\"item/{m.Groups[1].Value}\">{m.Value}</a>" : $"<span class=\"wl bad\">{m.Value}</span>");
            html = Regex.Replace(html, @"#n(\d+)\b", m => ok.Contains("note:" + m.Groups[1].Value) ? $"<a class=\"wl\" href=\"note/{m.Groups[1].Value}\">{m.Value}</a>" : $"<span class=\"wl bad\">{m.Value}</span>");
            return new MarkupString(html);
        }
    }

    public override void Dispose()
    {
        pendingSave?.Cancel();
        pendingPreview?.Cancel();
        if (self is not null)
        {
            // the page is leaving: stop listening (fire and forget; the circuit may already be gone)
            _ = Js.InvokeVoidAsync("rtm.stopPasteImages").AsTask().ContinueWith(_ => { }, TaskScheduler.Default);
            self.Dispose();
        }
        base.Dispose();
    }
}
