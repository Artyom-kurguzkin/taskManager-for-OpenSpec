@page "/note/{Id:int}"
@using System.Text.RegularExpressions
@using GitHistory
@using GitHistory.PublicDTOs
@using Notes
@using Notes.PublicDTOs
@inherits RepoPage

@if (note is null)
{
    <NotFound What="@($"#n{Id}")" />
    return;
}

<div class="sheet" data-sk="soft">
    <div class="head kvs">
        <div class="kv"><label>note</label><h2 class="num">#n@(note.Id)</h2></div>
        <div class="kv"><label>linked to</label><a class="wl" href="item/@note.WorkItemId">#wi@(note.WorkItemId)</a></div>
        <div class="kv"><label>created</label><span class="num">@note.Created.ToString("yyyy-MM-dd HH:mm")</span></div>
        <div class="kv"><label>last modified</label><span class="num">@modified.ToString("yyyy-MM-dd HH:mm")</span>@if (saving) { <span class="muted"> · saving…</span> }</div>
        <div class="kv"><label>by</label><span>@note.By</span></div>
        <BackButton />
    </div>
    @* the same tiles as the work item page: a coloured heading pill on each *@
    <div class="note-grid">
        <section class="tile" data-tile="markdown">
            <div class="tile-h"><h3>Markdown</h3><span class="muted">@note.Title</span></div>
            @* Uncontrolled: the text is set when the note loads and never pushed back while typing,
               so a re-render can't overwrite keystrokes that haven't reached .NET yet. *@
            <div data-sk="soft"><textarea class="md" value="@editorText" @oninput="OnInput" spellcheck="false" aria-label="Markdown editor"></textarea></div>
            <button class="add edit-ext" @onclick="EditExternally">@(Settings.Current.Editor is string e ? $"Edit in {e}" : "Edit in…")</button>
        </section>
        <section class="tile" data-tile="preview">
            <div class="tile-h"><h3>Preview</h3></div>
            <div class="preview">@Preview</div>
        </section>
        <section class="tile" data-tile="links">
            <div class="tile-h"><h3>Linked docs and commits</h3></div>
            <div class="links">
                @foreach (NoteLink l in links)
                {
                    <div class="link @(l.Resolved ? "hov" : "bad")" data-sk="@(l.Resolved ? "" : null)">
                        <span class="k">@l.Kind</span>
                        @if (l.Resolved && l.Kind != "doc") { <a class="wl" href="@(l.Kind == "item" ? "item" : "note")/@l.Target">@Label(l)</a> }
                        else { <span>@Label(l)</span> }
                        @if (!l.Resolved) { <span class="muted"> unresolved</span> }
                    </div>
                }
                @foreach (CommitInfo c in commits)
                {
                    bool picked = note.Commits.Contains(c.Hash);
                    <div class="link hov" data-sk><span class="k">commit</span><span><span class="mono">@c.Hash</span> @c.Subject</span>
                        @if (picked) { <button class="ic" aria-label="Unlink commit" title="Unlink" @onclick="() => UnlinkCommit(c.Hash)">×</button> }</div>
                }
                @foreach (string m in note.ManualLinks) { <div class="link"><span class="k">link</span><span>@m</span></div> }
            </div>
            @if (GitHistoryApi.IsRepository())
            {
                <PickerMenu TItem="CommitInfo" Label="Link a commit" ButtonText="+ link commit" Placeholder="Filter commits…"
                            Items="GitHistoryApi.Recent(50).Where(c => commits.All(x => x.Hash != c.Hash))" Text="c => [c.Hash, c.Subject, c.Author]" OnPick="c => LinkCommit(c.Hash)">
                    <ItemTemplate Context="c"><span class="mono">@c.Hash</span> @c.Subject <span class="muted">· @c.Author</span></ItemTemplate>
                </PickerMenu>
            }
            <form class="add-line" @onsubmit="AddLink" @onsubmit:preventDefault="true">
                <input @bind="newLink" placeholder="Add a link by hand…" aria-label="New link" /><button class="btn" data-sk type="submit">add</button>
            </form>
            <span class="muted">The list fills in as you type valid [[doc]], #wi and #n references.</span>
        </section>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Inject] private SettingsStore Settings { get; set; } = default!;
    [Inject] private IServiceProvider Services { get; set; } = default!;
    private EditorLauncher? Launcher => Services.GetService(typeof(EditorLauncher)) as EditorLauncher;

    private Note? note;
    private string body = "";          // latest typed text (saved by autosave)
    private string editorText = "";    // what the editor was loaded with; changes only on (re)load
    private string previewBody = "";   // what preview/links show; refreshed after a short pause in typing
    private CancellationTokenSource? pendingPreview;
    private DateTime modified;
    private IReadOnlyList<NoteLink> links = [];
    private IReadOnlyList<CommitInfo> commits = [];
    private string newLink = "";
    private bool saving;
    private CancellationTokenSource? pendingSave;

    // Outside edits reload the note, but never while there is typing not yet on disk (that would wipe it).
    protected override void OnChanged() { if (!saving) base.OnChanged(); }

    protected override void Load()
    {
        note = NotesApi.Get(Id);
        if (note is null) return;
        body = editorText = previewBody = note.Body;
        modified = note.Modified;
        links = NotesApi.ResolveLinks(body);
        commits = [.. GitHistoryApi.Mentioning($"#wi{note.WorkItemId}").Concat(GitHistoryApi.Commits(note.Commits)).DistinctBy(c => c.Hash)];
    }

    private void OnInput(ChangeEventArgs e)
    {
        body = (string?)e.Value ?? "";
        // ponytail: link resolution reads the repo, so do it on a 250 ms pause rather than per keystroke
        pendingPreview?.Cancel();
        CancellationTokenSource preview = pendingPreview = new();
        _ = Task.Delay(250, preview.Token).ContinueWith(t =>
        {
            if (t.IsCanceled) return;
            InvokeAsync(() => { previewBody = body; links = NotesApi.ResolveLinks(previewBody); StateHasChanged(); });
        }, TaskScheduler.Default);
        saving = true;
        pendingSave?.Cancel();
        CancellationTokenSource cts = pendingSave = new();
        _ = Task.Delay(600, cts.Token).ContinueWith(t => { if (!t.IsCanceled) InvokeAsync(Save); }, TaskScheduler.Default);
    }

    /// <summary>
    /// Autosave writes the file and nothing else: it must not trigger a reload, because the reload would put the
    /// saved text back into the editor and drop whatever was typed since. Other pages re-read on navigation.
    /// </summary>
    private void Save()
    {
        string saved = body;
        (bool ok, string message) = NotesApi.SaveBody(Id, saved);
        if (!ok) { saving = false; Popups.Toast(message, ToastKind.Warning); return; }
        modified = DateTime.Now;
        saving = body != saved;   // more typing arrived while saving: its own save is already scheduled
        StateHasChanged();
    }

    private void AddLink()
    {
        Run(NotesApi.AddManualLink(Id, newLink));
        newLink = "";
    }

    private static string Label(NoteLink l) => l.Kind switch { "item" => $"#wi{l.Target}", "note" => $"#n{l.Target}", _ => l.Target };

    private void LinkCommit(string hash) => Run(NotesApi.SetLinkedCommits(Id, [.. note!.Commits, hash]));

    private void UnlinkCommit(string hash) => Run(NotesApi.SetLinkedCommits(Id, note!.Commits.Where(h => h != hash)));

    private async Task EditExternally()
    {
        if (note is null) return;
        string? editor = Settings.Current.Editor;
        if (string.IsNullOrWhiteSpace(editor))
        {
            string? typed = await Popups.Prompt("Which editor should open files?", "e.g. code, notepad++, subl, or a full path", "Use it");
            if (string.IsNullOrWhiteSpace(typed)) return;
            editor = typed.Trim();
            Settings.Update(s => s with { Editor = editor });
        }
        if (Launcher is null) return;
        (bool ok, string message) = Launcher(editor, note.Path);
        if (!ok) Popups.Toast(message, ToastKind.Warning);
    }

    /// <summary>Markdig HTML with [[doc]], #wiN and #nN turned into links (unresolved ones struck through).</summary>
    private MarkupString Preview
    {
        get
        {
            HashSet<string> ok = links.Where(l => l.Resolved).Select(l => $"{l.Kind}:{l.Target}").ToHashSet();
            string html = Markdig.Markdown.ToHtml(previewBody, Ui.Pipeline);
            html = Regex.Replace(html, @"\[\[([^\]<]+)\]\]", m => $"<span class=\"wl{(ok.Contains("doc:" + m.Groups[1].Value.Trim()) ? "" : " bad")}\">{m.Groups[1].Value}</span>");
            html = Regex.Replace(html, @"#wi(\d+)\b", m => ok.Contains("item:" + m.Groups[1].Value) ? $"<a class=\"wl\" href=\"item/{m.Groups[1].Value}\">{m.Value}</a>" : $"<span class=\"wl bad\">{m.Value}</span>");
            html = Regex.Replace(html, @"#n(\d+)\b", m => ok.Contains("note:" + m.Groups[1].Value) ? $"<a class=\"wl\" href=\"note/{m.Groups[1].Value}\">{m.Value}</a>" : $"<span class=\"wl bad\">{m.Value}</span>");
            return new MarkupString(html);
        }
    }

    public override void Dispose()
    {
        pendingSave?.Cancel();
        pendingPreview?.Cancel();
        base.Dispose();
    }
}
