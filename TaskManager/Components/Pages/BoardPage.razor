@page "/"
@using TaskManager.Board
@using WorkItems
@using WorkItems.PublicDTOs
@implements IDisposable

@if (Workspace.Root is null)
{
    <div class="empty sheet" data-sk>
        <h2>Open a repository</h2>
        <p class="muted">Pick a folder that contains an <span class="mono">openspec/</span> directory in <a href="settings">Settings</a>.</p>
    </div>
    return;
}

@* view options, Board/List and "+ new work item" live in the side menu (Layout/SideNav) *@

@foreach (string w in WorkItemsApi.GetWarnings()) { <p class="warning">@w</p> }

@if (O.View == "list")
{
    <div class="scx"><div class="tbl-wrap" data-sk>
        <table class="tbl">
            <thead><tr><th></th><th><button class="chev @(expandAll ? "open" : "")" title="@(expandAll ? "Collapse all rows" : "Expand all rows")" @onclick="ToggleExpandAll">@Ui.Icon("chev")<span class="sr">@(expandAll ? "Collapse all rows" : "Expand all rows")</span></button></th>
                @foreach ((string key, string label) in Columns)
                {
                    <th>@if (key == "progress") { @label } else {
                        <button class="th-sort @(O.SortBy == key ? "on" : "")" @onclick="() => SortBy(key)">@label@(O.SortBy == key ? (O.SortDir > 0 ? " ↑" : " ↓") : "")</button> }</th>
                }
            </tr></thead>
            @foreach ((string? cat, BoardColumn col) in Flat)
            {
                bool shut = shutGroups.Contains(col.Key);
                <tbody>
                    <tr class="grp"><td colspan="11"><button @onclick="() => Toggle(shutGroups, col.Key)" aria-expanded="@(!shut)">
                        <span class="chev @(shut ? "" : "open")">@Ui.Icon("chev")</span><b>@col.Label</b> <span class="count">@col.Items.Count</span>
                        @if (cat is not null) { <span class="muted"> · @cat</span> }</button></td></tr>
                    @if (!shut)
                    {
                        @foreach (WorkItem it in col.Items)
                        {
                            bool open = expandAll || openRows.Contains(it.Id);
                            <tr class="lrow @(selected.Contains(it.Id) ? "selected" : "") @(it.Hidden ? "hidden-item" : "")">
                                <td><input type="checkbox" checked="@selected.Contains(it.Id)" @onchange="() => ToggleSelect(it)" aria-label="Select #wi@(it.Id)" /></td>
                                <td>@if (it.Subtasks.Count > 0) {
                                    <button class="chev @(open ? "open" : "")" @onclick="() => Toggle(openRows, it.Id)" aria-expanded="@open" aria-label="Subtasks">@Ui.Icon("chev")</button> }</td>
                                <td class="muted num id">#wi@(it.Id)</td>
                                <td><button class="row-title" @onclick="() => OpenItem(it.Id)">@it.Title</button></td>
                                <td>@if (it.Archived) { <span class="box cell filled" data-sk style="--fill:var(@Ui.Band(it.Status))">@it.Status</span> }
                                    else { <Dropdown Label="status" Class="cell filled" Style="@($"--fill:var({Ui.Band(it.Status)})")" Swatch="Ui.Band" Options="Statuses" Value="@it.Status" ValueChanged="v => SetStatus(it, v)" /> }</td>
                                <td><Dropdown Label="label" Class="cell" Options="LabelOptions" Value="@(it.Label ?? "")" ValueChanged="v => Run(WorkItemsApi.SetLabel(it.Id, v))" /></td>
                                <td>@foreach (FeatureLink f in it.Features) { <span class="tag">@Workspace.FeatureNames.GetValueOrDefault(f.Path, f.Path)</span> }</td>
                                <td>@string.Join(", ", it.Contributors)</td>
                                <td><Dropdown Label="priority" Class="cell" Options="Priorities" Value="@it.Priority" ValueChanged="v => Run(WorkItemsApi.SetPriority(it.Id, v))" /></td>
                                <td><span class="prog"><i style="width:@(it.Subtasks.Count == 0 ? 0 : it.Subtasks.Count(s => s.Done) * 100 / it.Subtasks.Count)%"></i></span>
                                    <span class="muted num">@it.Subtasks.Count(s => s.Done)/@it.Subtasks.Count</span></td>
                                <td class="muted num">@it.Modified.ToString("d MMM")</td>
                            </tr>
                            @if (open)
                            {
                                @foreach (Subtask s in it.Subtasks)
                                {
                                    <tr class="subrow"><td></td><td></td><td class="muted num">@s.Number</td>
                                        <td colspan="8"><label class="check @(s.Done ? "done" : "")"><input type="checkbox" checked="@s.Done"
                                            @onchange="e => Run(WorkItemsApi.SetSubtaskDone(it.Id, s.Number, (bool)e.Value!))" /> @s.Text</label></td></tr>
                                }
                            }
                        }
                        @if (!(O.GroupBy == "status" && col.Label == "Completed"))   // completed = archived by the CLI, not created here
                        {
                            <tr class="addrow"><td></td><td colspan="10"><button class="btn ghost" @onclick="() => NewItem(col.Key)">+ Add item</button></td></tr>
                        }
                    }
                </tbody>
            }
        </table>
    </div></div>
}
else
{
    <div class="scx"><div class="board-wrap @(selected.Count > 0 ? "selecting" : "")">
        <div class="board">
            @foreach (BoardSection sec in Sections)
            {
                <div class="cat">
                    @if (sec.Category is not null)
                    {
                        <div class="cat-h">
                            <h2>@sec.Category</h2>
                            @if (O.GroupBy is "bucket" or "feature") { <button class="btn ghost sm" @onclick="() => AddFeature(sec.Category)">+ feature</button> }
                        </div>
                    }
                    <div class="cat-cols">
                        @foreach (BoardColumn col in sec.Columns)
                        {
                            @* data-drop: wwwroot/js/app.js cancels dragover here (Blazor has no dragover handler, so its preventDefault never runs) *@
                            <section class="col @(dropTarget == col.Key ? "over" : "")" data-drop @ondragenter="() => dropTarget = col.Key" @ondrop="() => Drop(col, null)">
                                <Menu Label="Column options">
                                    <Activator>
                                        @* drag a header onto another column to reorder columns *@
                                        <header class="col-h hov" data-sk title="Column options · drag to reorder" draggable="@(col.Key != BoardModel.Unassigned ? "true" : "false")"
                                                @ondragstart="() => StartColumnDrag(sec.Columns.Select(c => BoardModel.ColumnKey(O, c.Key)).ToList(), BoardModel.ColumnKey(O, col.Key))"><h3>@col.Label</h3><span class="count">@BoardModel.Count(col.Items, O.Unit)</span></header>
                                    </Activator>
                                    <Items>
                                        <MenuItem OnClick="() => NewItem(col.Key)">+ Add work item here</MenuItem>
                                        <MenuItem OnClick="() => SelectAll(col)">Select all in column</MenuItem>
                                        <MenuItem OnClick="() => AddLane(col.Key, col.Label)">+ Add subgroup…</MenuItem>
                                        @foreach (string lane in col.Lanes)
                                        {
                                            <MenuItem OnClick="() => Run(WorkItemsApi.RemoveLane(col.Key, lane))">Remove subgroup “@lane”</MenuItem>
                                        }
                                        @if (col.Key != BoardModel.Unassigned)
                                        {
                                            <MenuItem OnClick="() => Set(BoardModel.ToggleHidden(O, BoardModel.ColumnKey(O, col.Key)))">Hide column</MenuItem>
                                        }
                                        @if (O.GroupBy is "bucket" or "feature" && features.FirstOrDefault(f => f.Path == col.Key) is { Custom: true } custom)
                                        {
                                            <MenuItem OnClick="() => DeleteFeature(custom)">Delete feature…</MenuItem>
                                        }
                                    </Items>
                                </Menu>
                                @if (col.Lanes.Count > 0)
                                {
                                    @foreach (string lane in col.Lanes)
                                    {
                                        List<WorkItem> inLane = BoardModel.InLane(col, lane).ToList();
                                        <div class="lane-h"><span>@lane</span><span class="count">@BoardModel.Count(inLane, O.Unit)</span></div>
                                        <div class="lane" data-drop @ondrop="() => Drop(col, lane)" @ondrop:stopPropagation="true">@Cards(col, inLane)</div>
                                    }
                                }
                                else
                                {
                                    <div class="lane" data-drop>@Cards(col, col.Items)</div>
                                }
                            </section>
                        }
                    </div>
                </div>
            }
        </div>
    </div></div>
   
}

@if (selected.Count > 0)
{
    <div class="actionbar" data-sk>
        <span class="n">@selected.Count selected</span>
        @if (selected.Count >= 2) { <button class="btn primary" data-sk @onclick="Merge">Merge into one work item</button> }
        else { <span class="muted">select one more to merge</span> }
        <button class="btn ghost hide-sel" data-sk @onclick="HideSelected">Delete (hide)</button>
        <button class="btn ghost" @onclick="() => selected.Clear()">Clear</button>
    </div>
}

@code {
    private RenderFragment Cards(BoardColumn col, IEnumerable<WorkItem> items) => __builder =>
    {
        foreach (WorkItem it in items)
        {
            if (O.Unit == "subtasks")
            {
                foreach (Subtask s in it.Subtasks)
                {
                    <article class="card subcard @(s.Done ? "done" : "")" data-sk @onclick="() => OpenItem(it.Id)">
                        <span class="band" style="--band:var(@Ui.Band(it.Status))">
                            <input type="checkbox" checked="@s.Done" @onclick:stopPropagation="true"
                                   @onchange="e => Run(WorkItemsApi.SetSubtaskDone(it.Id, s.Number, (bool)e.Value!))" aria-label="Done" />@s.Text
                        </span>
                        @if (!O.Compact) { <span class="muted">#wi@(it.Id) · @it.Title</span> }
                    </article>
                }
            }
            else
            {
                <WorkItemCard Item="it" Options="O" Selected="selected.Contains(it.Id)"
                              OnClick="e => CardClick(it, e)" OnToggleSelect="ToggleSelect" OnDragStart="i => { dragging = (i, col.Key); draggingColumn = null; }" />
            }
        }
    };
}
