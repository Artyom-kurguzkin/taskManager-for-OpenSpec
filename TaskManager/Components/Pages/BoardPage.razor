@page "/"
@using TaskManager.Board
@using WorkItems
@using WorkItems.PublicDTOs
@inherits RepoPage

@if (Workspace.Root is null)
{
    <div class="empty sheet" data-sk>
        <h2>Open a repository</h2>
        <p class="muted">Pick a folder that contains an <span class="mono">openspec/</span> directory in <a href="settings">Settings</a>.</p>
    </div>
    return;
}

@* view options, Board/List and "+ new work item" live in the side menu (Layout/SideNav) *@

@foreach (string w in WorkItemsApi.GetWarnings()) { <p class="warning">@w</p> }

@if (projects.Count == 0)
{
    <p class="muted">Every project is hidden. Bring one back from the side menu.</p>
}
else if (View == "calendar")
{
    <Roadmap Projects="RoadmapProjects" Multi="Multi" ColorBy="@O.ColorBy" OnOpen="OpenFrom" />
}
else if (View == "list")
{
    @* The list is a Radzen DataGrid over the projects' columns: one row per work item per column, in the board's order, grouped by
       project (when several are open) and column. The grid brings sorting, filtering (a funnel in each header), column resize and
       reorder, and remembers them per repository. A column is hidden from the × in its header and brought back from the side
       menu's Hidden list, like a board column; the side menu's compact switch hides every row's subtasks. Grouping, row drag
       (app.js: press and hold anywhere on a row, then move), arrow keys, cell copy and the subtask detail are the app's own, as on
       the board. .hdr-path is the sticky header's strip: app.js writes the group path of the rows scrolled under the header into it
       (from the data-path-* marks GroupRowRender puts on the group rows).
       tabindex: a click in the table focuses the wrapper, so arrow keys reach KeyDown and Ctrl+C reaches the cell copy. *@
    <div class="scx"><div class="tbl-wrap" tabindex="0" @onkeydown="KeyDown" @onclick="BackgroundClick">
        <div class="hdr-path" aria-hidden="true"></div>
        <RadzenDataGrid @ref="grid" TItem="GridRow" Data="rows" KeyProperty="Key" Density="Density.Compact" Groups="groupDescriptors"
                        AllowSorting="true" AllowMultiColumnSorting="true" AllowFiltering="true" FilterMode="FilterMode.Advanced"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowColumnResize="true" AllowColumnReorder="true"
                        GroupFootersAlwaysVisible="false" ExpandMode="DataGridExpandMode.Multiple" ShowExpandColumn="false"
                        GroupRowExpand="g => { if (IsProjectGroup(g)) SetProjectCollapsed(g, false); else shutGroups.Remove(ShutKey(g)); }" GroupRowCollapse="g => { if (IsProjectGroup(g)) SetProjectCollapsed(g, true); else shutGroups.Add(ShutKey(g)); }"
                        GridLines="DataGridGridLines.Horizontal" EmptyText="Nothing matches the filters."
                        RowRender="RowRender" GroupRowRender="GroupRowRender" Settings="gridSettings" SettingsChanged="SaveGridSettings">
            <GroupHeaderTemplate>
                @if (IsProjectGroup(context))
                {
                    string pname = (string)context.Data.Key;
                    <b class="gname proj-name">@pname</b>
                }
                else if (IsSwimGroup(context))
                {
                    List<GridRow> swimRows = SwimRowsOf(context);
                    @* an empty column's placeholder has no row value, so no heading *@
                    if (swimRows.FirstOrDefault()?.Swim.Length > 0)
                    {
                        <b class="gname swim-name">@(swimRows.First().SwimLabel)</b> <span class="count">@BoardModel.Count(swimRows.Where(r => r.Item is not null).Select(r => r.Item!).DistinctBy(i => i.Id), O.Unit)</span>
                    }
                }
                else
                {
                    (BoardColumn gcol, string? gcat, _) = GroupOf(context);
                    <b class="gname" style="@(O.GroupBy == "status" ? $"--fill:var({Ui.Band(gcol.Label)})" : null)">@gcol.Label</b> <span class="count">@BoardModel.Count(gcol.Items, O.Unit)</span>@if (gcat is not null) { <span class="muted"> · @gcat</span> }
                }
            </GroupHeaderTemplate>
            <Template Context="row">
                @if (row.Item is WorkItem it)
                {
                    <div class="subtasks">
                        @foreach (Subtask s in it.Subtasks)
                        {
                            <div class="subrow"><span class="muted num">@s.Number</span>
                                <label class="check @(s.Done ? "done" : "")"><input type="checkbox" checked="@s.Done"
                                    @onchange="e => Run(Workspace.In(row.Root, () => WorkItemsApi.SetSubtaskDone(it.Id, s.Number, (bool)e.Value!)))" /> @s.Text</label>
                                @if (s.Agent is not null) { <AgentChip By="@s.Agent" OnReview="() => Run(Workspace.In(row.Root, () => WorkItemsApi.MarkSubtaskReviewed(it.Id, s.Number)))" /> }</div>
                        }
                    </div>
                }
            </Template>
            <Columns>
                @* no gutter and no tick boxes: Shift-click selects a row, as it does a card, and a held press drags it (app.js) *@
                <RadzenDataGridColumn TItem="GridRow" Property="Id" Title="ID" Visible="@Shown("ID")" HeaderTemplate="@Head("ID")" Width="72px" CssClass="num" Filterable="false">
                    <Template Context="row">@if (row.Item is not null) { <span class="muted num id clip" title="#wi@(row.Id)">#wi@(row.Id)</span> }</Template>
                </RadzenDataGridColumn>
                @* the title: the one-line title, like a task name in Asana or Linear. A row with subtasks has a chevron (they fold out under
                   it) that hangs in the title column's left padding, so every title starts where the "Title" header does *@
                <RadzenDataGridColumn TItem="GridRow" Property="Title" Title="Title" Visible="@Shown("Title")" HeaderTemplate="@Head("Title")" MinWidth="260px" CssClass="title" HeaderCssClass="title">
                    <Template Context="row">
                        @if (row.Item is WorkItem it)
                        {
                            <span class="tcell">
                                @if (it.Subtasks.Count > 0)
                                {
                                    bool open = grid?.IsRowExpanded(row) == true;
                                    <button class="chev @(open ? "open" : "")" @onclick="() => ToggleRow(row)" aria-expanded="@open" aria-label="Subtasks">@Ui.Icon("chev")</button>
                                }
                                @* a modifier click is the row's (RowRender): it selects, as on a card; a plain click opens *@
                                <button class="row-title" title="@it.Title" @onclick="e => { if (!(e.ShiftKey || e.CtrlKey || e.MetaKey)) OpenItem(ProjectOf(row.Root), it.Id); }">@it.Title</button>
                            </span>
                        }
                        else { <span class="muted">No items</span> }
                    </Template>
                    <GroupFooterTemplate>
                        @if (IsLeafGroup(context))   @* the last level: the column, or with rows set its row values *@
                        {
                            GridRow? fgrow = IsSwimGroup(context) ? SwimRowsOf(context).FirstOrDefault() : null;
                            (BoardColumn fcol, _, string froot) = fgrow is null ? GroupOf(context) : (fgrow.Column, fgrow.Category, fgrow.Root);
                            @if (!(O.GroupBy == "status" && fcol.Label == "Completed")) { <button class="add" @onclick="() => NewItem(ProjectOf(froot), fcol.Key)">+ Add item</button> }   @* completed = archived by the CLI, not created here *@
                        }
                    </GroupFooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GridRow" Property="Status" Title="Status" Visible="@Shown("Status")" HeaderTemplate="@Head("Status")" Width="120px">
                    <Template Context="row">
                        @if (row.Item is WorkItem it)
                        {
                            <Pill Kind="status" Value="@it.Status" ReadOnly="it.Archived" ValueChanged="v => SetStatus(ProjectOf(row.Root), it, v)" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GridRow" Property="Label" Title="Label" Visible="@Shown("Label")" HeaderTemplate="@Head("Label")" Width="172px">
                    <Template Context="row">@if (row.Item is WorkItem it) { <Pill Kind="label" Value="@(it.Label ?? "")" ValueChanged="v => Run(Workspace.In(row.Root, () => WorkItemsApi.SetLabel(it.Id, v)))" /> }</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GridRow" Property="Feature" Title="Feature" Visible="@Shown("Feature")" HeaderTemplate="@Head("Feature")" Width="132px">
                    <Template Context="row">@if (row.Feature.Length > 0) { <span class="feat feat-one clip" title="@row.Feature">@row.Feature</span> }</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GridRow" Property="Contributors" Title="Contributors" Visible="@Shown("Contributors")" HeaderTemplate="@Head("Contributors")" Width="130px">
                    <Template Context="row"><span class="clip" title="@row.Contributors">@row.Contributors</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GridRow" Property="Priority" Title="Priority" Visible="@Shown("Priority")" HeaderTemplate="@Head("Priority")" Width="100px">
                    <Template Context="row">@if (row.Item is WorkItem it) { <Pill Kind="priority" Value="@it.Priority" ValueChanged="v => Run(Workspace.In(row.Root, () => WorkItemsApi.SetPriority(it.Id, v)))" /> }</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GridRow" Property="Progress" Title="Progress" Visible="@Shown("Progress")" HeaderTemplate="@Head("Progress")" Width="96px" Filterable="false">
                    <Template Context="row">@if (row.Item is WorkItem it) { <span class="pcell"><span class="prog"><i style="width:@(row.Progress)%"></i></span> <span class="muted num">@it.Subtasks.Count(s => s.Done)/@it.Subtasks.Count</span></span> }</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GridRow" Property="Modified" Title="Updated" Visible="@Shown("Updated")" HeaderTemplate="@Head("Updated")" Width="88px" FormatString="{0:d MMM}" CssClass="num muted" Filterable="false">
                    <Template Context="row"><span class="clip" title="@Day(row.Modified)">@Day(row.Modified)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GridRow" Property="Started" Title="Started" Visible="@Shown("Started")" HeaderTemplate="@Head("Started")" Width="88px" FormatString="{0:d MMM}" CssClass="num muted" Filterable="false">
                    <Template Context="row"><span class="clip" title="@Day(row.Started)">@Day(row.Started)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GridRow" Property="Due" Title="Due" Visible="@Shown("Due")" HeaderTemplate="@Head("Due")" Width="88px" FormatString="{0:d MMM}" CssClass="num" Filterable="false">
                    <Template Context="row"><span class="clip" title="@Day(row.Due)">@Day(row.Due)</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="GridRow" Property="Moved" Title="In status since" Visible="@Shown("In status since")" HeaderTemplate="@Head("In status since")" Width="110px" FormatString="{0:d MMM}" CssClass="num muted" Filterable="false">
                    <Template Context="row"><span class="clip" title="@Day(row.Moved)">@Day(row.Moved)</span></Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div></div>
}
else
{
    @* The board: every open project (tab) stacked, each a block of its columns. With several projects whose columns are the same
       (status or label grouping) one header row above serves them all. tabindex: clicking a card focuses the wrapper, so the arrow
       keys reach KeyDown (app.js stops them scrolling) *@
    <div class="scx"><div class="board-wrap @(Multi ? "multi" : "") @(Aligned ? "aligned" : "")" tabindex="0" @onkeydown="KeyDown" @onclick="BackgroundClick">
        <div class="board">
            @if (Aligned)
            {
                <div class="head-row cat-cols" data-proj="" @ondrop="() => DropColumn(HeadKeys, null)">
                    @foreach (BoardColumn col in projects[0].Sections[0].Columns)
                    {
                        <section class="col head-only" data-key="@col.Key">
                            <Menu Label="Column options">
                                <Activator>
                                    @* drag a header along the row to reorder columns, in every project at once *@
                                    <header class="col-h hov" data-sk title="Column options · drag to reorder" data-drag-col="@(col.Key != BoardModel.Unassigned)"
                                            @ondragstart="() => StartColumnDrag(HeadKeys, BoardModel.ColumnKey(O, col.Key))">
                                        <h3>@col.Label</h3><span class="count">@projects.Sum(p => p.Sections[0].Columns.Where(c => c.Key == col.Key).Sum(c => BoardModel.Count(c.Items, O.Unit)))</span>
                                    </header>
                                </Activator>
                                <Items>
                                    <MenuItem OnClick="() => NewItem(null, col.Key)">+ Add work item here…</MenuItem>
                                    <MenuItem OnClick="() => SelectAllProjects(col.Key)">Select all in column</MenuItem>
                                    @if (col.Key != BoardModel.Unassigned)
                                    {
                                        <MenuItem OnClick="() => Set(BoardModel.ToggleHidden(O, BoardModel.ColumnKey(O, col.Key)))">Hide column</MenuItem>
                                    }
                                </Items>
                            </Menu>
                        </section>
                    }
                </div>
            }
            @foreach (Project p in projects)
            {
                <section class="proj" data-proj="@p.Name">
                    @if (Multi)
                    {
                        @* Shift-click the heading to select the project; the arrow keys then move it, as cards *@
                        <div class="proj-h @(selectedProjects.Contains(p.Root) ? "selected" : "")" @onclick="e => ProjectClick(p.Root, e)" @onclick:stopPropagation="true">
                            <button class="chev @(Collapsed(p) ? "" : "open")" @onclick:stopPropagation="true" aria-expanded="@(Collapsed(p) ? "false" : "true")" aria-label="@(Collapsed(p) ? $"Expand {p.Name}" : $"Collapse {p.Name}")"
                                    @onclick="() => Settings.ToggleProjectCollapsed(p.Root)">@Ui.Icon("chev")</button>
                            <h2>@p.Name</h2>
                            @if (IsActive(p)) { <span class="muted">active</span> }
                            <Menu Label="Project options">
                                <Activator><button type="button" class="ic" aria-label="Project options" title="Project options">@Ui.Icon("sliders")</button></Activator>
                                <Items>
                                    @if (!IsActive(p)) { <MenuItem OnClick="() => Workspace.Open(p.Root)">Make it the active project</MenuItem> }
                                    <MenuItem OnClick="() => Settings.ToggleProjectHidden(p.Root)">Hide project</MenuItem>
                                </Items>
                            </Menu>
                        </div>
                    }
                    @if (!Multi || !Collapsed(p))
                    {
                        <div class="cats">
                            @foreach (BoardSection sec in p.Sections)
                            {
                                <div class="cat">
                                    @if (O.Swimlane != BoardModel.NoSwimlane) { @Swim(p, sec) }
                                    else {
                                    @* a header dropped past the last column (the drag script sends that drop to the row) *@
                                    <div class="cat-cols" @ondrop="() => DropColumn(sec.Columns.Select(c => BoardModel.ColumnKey(O, c.Key)).ToList(), null)">
                                        @foreach (BoardColumn col in sec.Columns)
                                        {
                                            @* data-drop / data-key: wwwroot/js/app.js drags with pointer events and sends synthetic dragstart / drop events to these handlers *@
                                            <section class="col" data-drop data-key="@col.Key" @ondrop="() => Drop(p, col, null)" @ondrop:stopPropagation="true">
                                                @if (!Aligned)
                                                {
                                                    <Menu Label="Column options">
                                                        <Activator>
                                                            @* drag a header along the row to reorder columns *@
                                                            <header class="col-h hov" data-sk title="Column options · drag to reorder" data-drag-col="@(col.Key != BoardModel.Unassigned)"
                                                                    @ondragstart="() => StartColumnDrag(sec.Columns.Select(c => BoardModel.ColumnKey(O, c.Key)).ToList(), BoardModel.ColumnKey(O, col.Key))"><h3>@col.Label</h3><span class="count">@BoardModel.Count(col.Items, O.Unit)</span></header>
                                                        </Activator>
                                                        <Items>
                                                            <MenuItem OnClick="() => NewItem(p, col.Key)">+ Add work item here</MenuItem>
                                                            <MenuItem OnClick="() => SelectAll(p, col)">Select all in column</MenuItem>
                                                            @if (col.Key != BoardModel.Unassigned)
                                                            {
                                                                <MenuItem OnClick="() => Set(BoardModel.ToggleHidden(O, BoardModel.ColumnKey(O, col.Key)))">Hide column</MenuItem>
                                                            }
                                                            @if (O.GroupBy == "feature" && p.Features.FirstOrDefault(f => f.Path == col.Key) is { } feature)
                                                            {
                                                                <MenuItem OnClick="() => RenameFeature(p, feature)">Rename feature…</MenuItem>
                                                                <MenuItem OnClick="() => DeleteFeature(p, feature)">Delete feature…</MenuItem>
                                                            }
                                                        </Items>
                                                    </Menu>
                                                }
                                                <div class="lane" data-drop>@Cards(p, col, col.Items, null)</div>
                                            </section>
                                        }
                                        @if (O.GroupBy == "feature") { <button class="add add-col" @onclick="() => AddFeature(p)">+ feature</button> }   @* a new feature is a new column *@
                                    </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        </div>
    </div></div>
}

@if (selected.Count > 0)
{
    <div class="actionbar" data-sk>
        <span class="n">@selected.Count selected</span>
        @if (selected.Count >= 2) { <button class="btn primary" data-sk @onclick="Merge">Merge into one work item</button> }
        else { <span class="muted">select one more to merge</span> }
        <button class="btn ghost hide-sel" data-sk @onclick="HideSelected">Delete (hide)</button>
        <button class="btn ghost" @onclick="() => selected.Clear()">Clear</button>
    </div>
}
else if (View == "list" || O.Unit == "tasks")
{
    @* shown by the drag script while Shift is held (body.shift-held), so select mode announces itself before the first click *@
    <div class="actionbar select-hint"><span class="n">Select mode</span><span class="muted">@(View == "list" ? "Shift-click rows to select them" : "Shift-click cards to select them")</span></div>
}

@code {
    // A list column's header: its title and a × that hides it (the side menu's Hidden list brings it back).
    private RenderFragment Head(string column) => __builder =>
    {
        <span class="th-l">@column</span>
        @* its own mouseup, or the header would also sort *@
        <button type="button" class="th-hide" aria-label="Hide @column column" title="Hide column" @onmouseup:stopPropagation="true" @onclick:stopPropagation="true"
                @onclick="() => Set(BoardModel.ToggleHidden(O, BoardModel.ListColumnKey(column)))">×</button>
    };

    // A section with swimlanes: its column headers once, then per swimlane a heading and a cell per column. Dropping on a cell sets
    // the column's value and the swimlane's (Drop → MoveInto). A cell has no data-key (the drag script's FLIP animation keys columns by it).
    private RenderFragment Swim(Project p, BoardSection sec) => __builder =>
    {
        List<string> keys = sec.Columns.Select(c => BoardModel.ColumnKey(O, c.Key)).ToList();
        List<string> rowKeys = RowKeys(sec);
        <div class="head-row cat-cols swim-cols" @ondrop="() => DropColumn(keys, null)">
            @foreach (BoardColumn col in sec.Columns)
            {
                <section class="col head-only" data-key="@col.Key" @ondrop="() => DropColumn(keys, BoardModel.ColumnKey(O, col.Key))" @ondrop:stopPropagation="true">
                    <Menu Label="Column options">
                        <Activator>
                            <header class="col-h hov" data-sk title="Column options · drag to reorder" data-drag-col="@(col.Key != BoardModel.Unassigned)"
                                    @ondragstart="() => StartColumnDrag(keys, BoardModel.ColumnKey(O, col.Key))"><h3>@col.Label</h3><span class="count">@BoardModel.Count(col.Items, O.Unit)</span></header>
                        </Activator>
                        <Items>
                            <MenuItem OnClick="() => NewItem(p, col.Key)">+ Add work item here</MenuItem>
                            <MenuItem OnClick="() => SelectAll(p, col)">Select all in column</MenuItem>
                            @if (col.Key != BoardModel.Unassigned)
                            {
                                <MenuItem OnClick="() => Set(BoardModel.ToggleHidden(O, BoardModel.ColumnKey(O, col.Key)))">Hide column</MenuItem>
                            }
                            @if (O.GroupBy == "feature" && p.Features.FirstOrDefault(f => f.Path == col.Key) is { } feature)
                            {
                                <MenuItem OnClick="() => RenameFeature(p, feature)">Rename feature…</MenuItem>
                                <MenuItem OnClick="() => DeleteFeature(p, feature)">Delete feature…</MenuItem>
                            }
                        </Items>
                    </Menu>
                </section>
            }
            @if (O.GroupBy == "feature") { <button class="add add-col" @onclick="() => AddFeature(p)">+ feature</button> }
        </div>
        @foreach (SwimRow row in BoardModel.Swimlanes(sec))
        {
            string rowKey = BoardModel.RowKey(O.Swimlane, row.Key);
            @* Shift-click selects the row (the arrow keys then move it), a drag moves it (app.js, kind "swim"), the × hides it *@
            <div class="swim-h @(selectedRows.Contains(rowKey) ? "selected" : "")" data-swim="@row.Key" title="Shift-click to select · drag to reorder"
                 @onclick="e => RowClick(rowKey, e)" @ondragstart="() => StartRowDrag(rowKeys, rowKey)" @ondrop="() => DropRow(rowKey)" @ondrop:stopPropagation="true">
                <span>@row.Label</span><span class="count">@BoardModel.Count(row.Items, O.Unit)</span>
                <button type="button" class="swim-hide" aria-label="Hide row @row.Label" title="Hide row" @onclick:stopPropagation="true"
                        @onclick="() => HideRow(rowKey)">×</button>
            </div>
            <div class="cat-cols swim" data-swim="@row.Key" @ondrop="() => DropRow(null)">
                @foreach (BoardColumn cell in row.Columns)
                {
                    <section class="col" data-drop data-cell="@cell.Key" @ondrop="() => Drop(p, cell, row.Key)" @ondrop:stopPropagation="true">
                        <div class="lane" data-drop>@Cards(p, cell, cell.Items, row.Key)</div>
                    </section>
                }
            </div>
        }
    };

    private RenderFragment Cards(Project p, BoardColumn col, IEnumerable<WorkItem> items, string? swim) => __builder =>
    {
        foreach (WorkItem it in items)
        {
            if (O.Unit == "subtasks")
            {
                foreach (Subtask s in it.Subtasks)
                {
                    <article class="card subcard @(s.Done ? "done" : "")" data-sk @onclick="() => OpenItem(p, it.Id)">
                        <span class="band" style="--band:var(@BoardModel.ColourOf(it, O.ColorBy, null, p.Colours))">
                            <input type="checkbox" checked="@s.Done" @onclick:stopPropagation="true"
                                   @onchange="e => Run(Workspace.In(p.Root, () => WorkItemsApi.SetSubtaskDone(it.Id, s.Number, (bool)e.Value!)))" aria-label="Done" />@s.Text
                        </span>
                        @if (!O.Compact) { <span class="muted">#wi@(it.Id) · @it.Title</span> }
                    </article>
                }
            }
            else
            {
                <WorkItemCard Item="it" Options="O" Names="p.Names" Colours="p.Colours" Selected="selected.Contains((p.Root, it.Id))"
                              OnClick="e => CardClick(p, it, e)" OnDragStart="i => StartCardDrag(p, i, col.Key, swim)" OnDrop="t => DropBefore(p, col, t, swim)" OnReview="i => ReviewItem(p, i)" />
            }
        }
    };
}
