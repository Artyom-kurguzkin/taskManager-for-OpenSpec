@inherits RtmLayout
@implements IDisposable
@using TaskManager.Components.Pages

@* One error boundary over everything the layout draws: a failing component is logged and replaced by a message with a Reload link, never a blank window. *@
<AppErrorBoundary>
<DebugThrow Uri="@Nav.Uri" />
@* nav items are buttons, not links: WebView2 shows a "localhost/…" bubble when hovering links *@
@if (Detached)
{
    @* a separate window on one work item: the page alone, no side menu, no list *@
    <main>@Body</main>
}
else
{
<SideNav />
@if (Panes.All.Count == 1)
{
    <main>@Body</main>
}
else
{
    @* Split: each pane is its own page by its own address (the window's router only follows the active one, so Body is not used). The window keeps one side menu,
       which acts on the active pane; a pointer-down or focus in a pane makes it the active one before its click runs. In a narrow window only the active pane is built. *@
    <main class="panes">
        @foreach (Pane pane in Shown)
        {
            <section @key="pane" class="pane @(pane == Panes.Active ? "active" : "")" data-pane="@Panes.Number(pane)" @onpointerdown="() => Panes.Activate(pane)" @onfocusin="() => Panes.Activate(pane)">
                <PaneHost Pane="pane" />
            </section>
        }
    </main>
}
}
<Overlays />
</AppErrorBoundary>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    [Inject] private SettingsStore Settings { get; set; } = default!;
    [Inject] private Workspace Workspace { get; set; } = default!;
    [Inject] private UiService Popups { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;
    [Inject] private IServiceProvider Services { get; set; } = default!;

    private bool systemDark;
    private DotNetObjectReference<MainLayout>? self;

    private bool Detached => Services.GetService(typeof(AppMode)) is AppMode { Detached: true };

    private Panes Panes => Popups.Panes;

    private IReadOnlyList<Pane> Shown => narrowWindow ? new List<Pane> { Panes.Active } : Panes.All;

    /// <summary>The window's address, base-relative ("" for the board, item/&lt;n&gt;, settings ...).</summary>
    private string CurrentPath => Nav.ToBaseRelativePath(Nav.Uri);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocation;
        Panes.Changed += OnPanes;
        if (Services.GetService(typeof(AppMode)) is AppMode { StartPath: string path } mode)
        {
            mode.StartPath = null;   // once
            Nav.NavigateTo(path);    // a detached window opens on its work item
        }
        Panes.Navigate(Panes.Active, CurrentPath);
        Settings.Changed += OnSettings;
    }

    /// <summary>The window's address follows the active pane: a navigation through Nav lands in it.</summary>
    private void OnLocation(object? sender, LocationChangedEventArgs e)
    {
        Panes.Navigate(Panes.Active, CurrentPath);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>A pane was added, closed, activated or moved: the address goes to the active pane's, and the layout draws.</summary>
    private void OnPanes() => InvokeAsync(() =>
    {
        if (Panes.Active.Path != CurrentPath) Nav.NavigateTo(Panes.Active.Path, replace: true);
        StateHasChanged();
    });

    /// <summary>Alt+\: another pane to the right of the active one, showing the same page. Four at most.</summary>
    [JSInvokable]
    public Task SplitPane() => InvokeAsync(() =>
    {
        if (Detached) return;
        if (Panes.Split() is null) Popups.Toast("Four tabs is the most.", ToastKind.Info);
    });

    /// <summary>Ctrl+W: closes the active pane. The last one stays: this never closes the window.</summary>
    [JSInvokable]
    public Task ClosePane() => InvokeAsync(() =>
    {
        if (!Detached) Panes.Close(Panes.Active);
    });

    /// <summary>Alt+Win+\: one more full window, on the active pane's page.</summary>
    [JSInvokable]
    public Task OpenWindow() => InvokeAsync(() =>
    {
        if (Detached) return;
        if (Services.GetService(typeof(MainWindowLauncher)) is not MainWindowLauncher open) { Popups.Toast("This window can't open another one.", ToastKind.Warning); return; }
        (bool ok, string message) = open(Panes.Active.Path);
        if (!ok) Popups.Toast(message, ToastKind.Warning);
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (Workspace.TakeGuideNotice() is string notice) Popups.Toast(notice, ToastKind.Info);   // an agent guide written while the app started
        self = DotNetObjectReference.Create(this);
        systemDark = await Js.InvokeAsync<bool>("rtm.watchDark", self);   // current OS setting + notify on change
        await Js.InvokeVoidAsync("rtm.watchPanes", self);   // Alt+\, Ctrl+W, Alt+Win+\
        bool narrow = await Js.InvokeAsync<bool>("rtm.watchNarrow", self);
        if (narrow != narrowWindow) { narrowWindow = narrow; Popups.SetNarrowWindow(narrow); StateHasChanged(); }
        await ApplyTheme();
    }

    private bool narrowWindow;   // too narrow for panes side by side: only the active one is built

    [JSInvokable]
    public Task NarrowChanged(bool narrow) => InvokeAsync(() => { narrowWindow = narrow; Popups.SetNarrowWindow(narrow); StateHasChanged(); });

    [JSInvokable]
    public Task SystemDarkChanged(bool isDark)
    {
        systemDark = isDark;
        return InvokeAsync(ApplyTheme);
    }

    private void OnSettings() => InvokeAsync(async () =>
    {
        await ApplyTheme();
    });

    /// <summary>Theme comes from Settings (Light / Dark / System); the CSS tokens switch on html[data-theme]. The keyboard
    /// hints switch goes to the script the same way.</summary>
    private async Task ApplyTheme()
    {
        string theme = Settings.Current.Theme;
        bool dark = theme == "dark" || (theme == "system" && systemDark);
        await Js.InvokeVoidAsync("rtm.setTheme", theme);
        await Js.InvokeVoidAsync("rtm.setHints", Settings.Current.Hints);
        (Services.GetService(typeof(WindowFrame)) as WindowFrame)?.Apply(dark);   // desktop host only
    }

    public void Dispose()
    {
        Settings.Changed -= OnSettings;
        Panes.Changed -= OnPanes;
        Nav.LocationChanged -= OnLocation;
        self?.Dispose();
    }
}
