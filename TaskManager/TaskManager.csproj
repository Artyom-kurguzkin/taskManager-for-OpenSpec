<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Host / composition root: the only project with UI and DI. Modules are configured from Program.cs. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>TaskManager</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>wwwroot/icon.ico</ApplicationIcon>   <!-- drawn from wwwroot/icon.svg (Artyom's signature) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="Radzen.Blazor" Version="12.1.6" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../OpenSpecStore/OpenSpecStore.csproj" />
    <ProjectReference Include="../GitHistory/GitHistory.csproj" />
    <ProjectReference Include="../Features/Features.csproj" />
    <ProjectReference Include="../WorkItems/WorkItems.csproj" />
    <ProjectReference Include="../Notes/Notes.csproj" />
    <ProjectReference Include="../LinkedTestRuns/LinkedTestRuns.csproj" />
    <ProjectReference Include="../TaskManager.Mcp/TaskManager.Mcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
